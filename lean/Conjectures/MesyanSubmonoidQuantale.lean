import Mathlib

/-!
# Complete Resolution of the First Part of Mesyan's Question 34 (`arXiv:2611.31109v1`)

Reference: Z. Mesyan, "Quantales Arising From Rings", arXiv:2611.31109v1 [math.RA]
(23 Nov 2026), Section 9, Question 34.

Verbatim Question 34:
> "For a domain `R`, is `R` being commutative equivalent to `M(R)` being commutative?
> (See Proposition 22 (3) and subsequent comments.) More broadly, for which (semi)rings `R`
> is `M(R)` commutative?"

Here a semiring is a `NonUnitalSemiring` (no multiplicative identity is assumed), a domain is
a nonzero semiring with no zero divisors (`Nontrivial R`, `NoZeroDivisors R`), and `M(R)` is
the quantale of additive submonoids of `R` equipped with multiplication
`S * T = AddSubmonoid.closure {s * t | s ∈ S, t ∈ T}` (Definition 4).

We prove that the answer splits cleanly between rings and semirings:
1. **Reduction (`submonoidMul_comm_iff`):** For any `NonUnitalSemiring R`, `M(R)` is commutative
   iff `AddSubmonoid.closure {r * s} = AddSubmonoid.closure {s * r}` for all `r, s : R`.
2. **Theorem A (`mesyan_Q34_rings`):** For every ring domain (`NonUnitalRing R`, `NoZeroDivisors R`),
   `M(R)` is commutative iff `R` is commutative.
3. **Theorem B (`mesyan_Q34_semirings_counterexample`):** There exists a 14-element semiring domain
   `R14` (`NonUnitalSemiring R14`, `Nontrivial R14`, `NoZeroDivisors R14`) that is noncommutative
   while `M(R14)` is commutative.
-/

namespace MesyanSubmonoidQuantale

/-! ### Section 1: The Submonoid Quantale `M(R)` and Reduction `(R)` -/

/-- Quantale multiplication on additive submonoids of a (possibly nonunital) semiring:
`S * T` is the additive submonoid generated by `{s * t | s ∈ S, t ∈ T}` (Definition 4). -/
def submonoidMul {R : Type*} [NonUnitalSemiring R] (S T : AddSubmonoid R) : AddSubmonoid R :=
  AddSubmonoid.closure {x : R | ∃ s ∈ S, ∃ t ∈ T, x = s * t}

/-- Commutativity of the submonoid quantale `M(R)`. -/
def quantaleCommutative (R : Type*) [NonUnitalSemiring R] : Prop :=
  ∀ S T : AddSubmonoid R, submonoidMul S T = submonoidMul T S

/-- Elements of the cyclic additive submonoid `AddSubmonoid.closure {x}` are precisely
the `ℕ`-multiples `n • x`. -/
lemma mem_closure_singleton_iff {R : Type*} [AddCommMonoid R] (x y : R) :
    y ∈ AddSubmonoid.closure ({x} : Set R) ↔ ∃ n : ℕ, n • x = y := by
  constructor
  · intro hy
    refine AddSubmonoid.closure_induction (s := ({x} : Set R))
      (motive := fun z _ => ∃ n : ℕ, n • x = z)
      (fun z hz => ⟨1, by rw [Set.mem_singleton_iff.mp hz, one_nsmul]⟩)
      ⟨0, zero_nsmul x⟩
      (fun a b _ _ ⟨n, hn⟩ ⟨m, hm⟩ => ⟨n + m, by rw [add_nsmul, hn, hm]⟩)
      hy
  · rintro ⟨n, rfl⟩
    exact nsmul_mem (AddSubmonoid.subset_closure (Set.mem_singleton x)) n

/-- Lemma 21(1) of Mesyan: `⟨r⟩ * ⟨s⟩ = ⟨r * s⟩` in `M(R)`. -/
lemma submonoidMul_closure_singleton {R : Type*} [NonUnitalSemiring R] (r s : R) :
    submonoidMul (AddSubmonoid.closure ({r} : Set R)) (AddSubmonoid.closure ({s} : Set R)) =
      AddSubmonoid.closure ({r * s} : Set R) := by
  apply le_antisymm
  · rw [submonoidMul, AddSubmonoid.closure_le]
    rintro x ⟨a, ha, b, hb, rfl⟩
    obtain ⟨n, rfl⟩ := (mem_closure_singleton_iff r a).mp ha
    obtain ⟨m, rfl⟩ := (mem_closure_singleton_iff s b).mp hb
    change n • r * m • s ∈ AddSubmonoid.closure ({r * s} : Set R)
    rw [mem_closure_singleton_iff]
    exact ⟨n * m, by rw [smul_mul_assoc, mul_smul_comm, ← mul_nsmul']⟩
  · rw [AddSubmonoid.closure_le]
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact AddSubmonoid.subset_closure
      ⟨r, AddSubmonoid.subset_closure (Set.mem_singleton r),
       s, AddSubmonoid.subset_closure (Set.mem_singleton s), rfl⟩

/-- **Reduction `(R)`:** `M(R)` is commutative iff `⟨r * s⟩ = ⟨s * r⟩` for all `r, s : R`. -/
theorem submonoidMul_comm_iff {R : Type*} [NonUnitalSemiring R] :
    quantaleCommutative R ↔
      ∀ r s : R, AddSubmonoid.closure ({r * s} : Set R) = AddSubmonoid.closure ({s * r} : Set R) := by
  constructor
  · intro hcomm r s
    rw [← submonoidMul_closure_singleton r s, ← submonoidMul_closure_singleton s r]
    exact hcomm _ _
  · intro hcyc
    have hle : ∀ S T : AddSubmonoid R, submonoidMul S T ≤ submonoidMul T S := by
      intro S T
      rw [submonoidMul, AddSubmonoid.closure_le]
      rintro x ⟨s, hs, t, ht, rfl⟩
      have hmem : s * t ∈ AddSubmonoid.closure ({t * s} : Set R) := by
        rw [← hcyc s t]
        exact AddSubmonoid.subset_closure (Set.mem_singleton (s * t))
      have hsub : AddSubmonoid.closure ({t * s} : Set R) ≤ submonoidMul T S := by
        rw [AddSubmonoid.closure_le]
        rintro y hy
        rw [Set.mem_singleton_iff] at hy
        subst hy
        exact AddSubmonoid.subset_closure ⟨t, ht, s, hs, rfl⟩
      exact hsub hmem
    intro S T
    exact le_antisymm (hle S T) (hle T S)

/-! ### Section 2: Theorem A — Affirmative Answer for Ring Domains -/

/-- **Theorem A:** Let `R` be a (possibly nonunital) ring without zero divisors.
Then `M(R)` is commutative iff `R` is commutative. -/
theorem mesyan_Q34_rings {R : Type*} [NonUnitalRing R] [NoZeroDivisors R] :
    quantaleCommutative R ↔ ∀ a b : R, a * b = b * a := by
  constructor
  · intro hQ
    have hcyc := submonoidMul_comm_iff.mp hQ
    intro a b
    by_contra hne
    have ha0 : a ≠ 0 := by rintro rfl; simp at hne
    have hb0 : b ≠ 0 := by rintro rfl; simp at hne
    have hab0 : a * b ≠ 0 := mul_ne_zero ha0 hb0
    have hba0 : b * a ≠ 0 := mul_ne_zero hb0 ha0
    -- Step 1: `b * a = n • (a * b)` and `a * b = m • (b * a)` give a positive torsion multiple.
    have hba_mem : b * a ∈ AddSubmonoid.closure ({a * b} : Set R) := by
      rw [hcyc a b]; exact AddSubmonoid.subset_closure (Set.mem_singleton _)
    have hab_mem : a * b ∈ AddSubmonoid.closure ({b * a} : Set R) := by
      rw [← hcyc a b]; exact AddSubmonoid.subset_closure (Set.mem_singleton _)
    obtain ⟨n, hn⟩ := (mem_closure_singleton_iff (a * b) (b * a)).mp hba_mem
    obtain ⟨m, hm⟩ := (mem_closure_singleton_iff (b * a) (a * b)).mp hab_mem
    have hn_pos : 0 < n := by
      rcases Nat.eq_zero_or_pos n with rfl | hpos
      · rw [zero_nsmul] at hn; exact absurd hn.symm hba0
      · exact hpos
    have hm_pos : 0 < m := by
      rcases Nat.eq_zero_or_pos m with rfl | hpos
      · rw [zero_nsmul] at hm; exact absurd hm.symm hab0
      · exact hpos
    have hmn_gt1 : 1 < m * n := by
      have hmn_ge1 : 1 ≤ m * n := Nat.mul_pos hm_pos hn_pos
      have hmn_ne1 : m * n ≠ 1 := by
        intro h1
        have hn1 : n = 1 := (mul_eq_one.mp h1).2
        rw [hn1, one_nsmul] at hn
        exact hne hn
      omega
    have hex_tor : ∃ k : ℕ, 0 < k ∧ k • (a * b) = 0 := by
      refine ⟨m * n - 1, by omega, ?_⟩
      have hmn_ab : (m * n) • (a * b) = a * b := by
        rw [mul_nsmul', hn, hm]
      have hadd : (m * n - 1) • (a * b) + a * b = a * b := by
        calc (m * n - 1) • (a * b) + a * b
            = (m * n - 1 + 1) • (a * b) := by rw [add_nsmul, one_nsmul]
          _ = (m * n) • (a * b) := by rw [Nat.sub_add_cancel (by omega)]
          _ = a * b := hmn_ab
      exact add_right_cancel (hadd.trans (zero_add (a * b)).symm)
    -- Step 2: Let `p` be the minimal positive integer with `p • (a * b) = 0`. Then `p` is prime
    -- and `p` annihilates all of `R`.
    classical
    let p : ℕ := Nat.find hex_tor
    have hp_spec : 0 < p ∧ p • (a * b) = 0 := Nat.find_spec hex_tor
    have hp_pos : 0 < p := hp_spec.1
    have hp_ab : p • (a * b) = 0 := hp_spec.2
    have hp_min : ∀ k : ℕ, 0 < k → k < p → k • (a * b) ≠ 0 := fun k hk hlt h0 =>
      Nat.find_min hex_tor hlt ⟨hk, h0⟩
    have hp_all : ∀ y : R, p • y = 0 := by
      intro y
      have hmul : (a * b) * (p • y) = 0 := by
        rw [mul_smul_comm, ← smul_mul_assoc, hp_ab, zero_mul]
      exact (mul_eq_zero.mp hmul).resolve_left hab0
    have hp_dvd_of_nsmul : ∀ {y : R} {k : ℕ}, y ≠ 0 → k • y = 0 → p ∣ k := by
      intro y k hy hky
      have hrem_ab : (k % p) • (a * b) = 0 := by
        have hk_ab : k • (a * b) = 0 := by
          have hmul : (k • (a * b)) * y = 0 := by
            rw [smul_mul_assoc, ← mul_smul_comm, hky, mul_zero]
          exact (mul_eq_zero.mp hmul).resolve_right hy
        have hdiv := Nat.div_add_mod k p
        have hsum : (p * (k / p)) • (a * b) + (k % p) • (a * b) = 0 := by
          rw [← add_nsmul, hdiv, hk_ab]
        rw [mul_nsmul, hp_ab, nsmul_zero, zero_add] at hsum
        exact hsum
      by_contra hndvd
      have hmod_pos : 0 < k % p := Nat.pos_of_ne_zero (fun h0 => hndvd (Nat.dvd_of_mod_eq_zero h0))
      exact hp_min (k % p) hmod_pos (Nat.mod_lt k hp_pos) hrem_ab
    have hp_prime : Nat.Prime p := by
      rw [Nat.prime_def]
      refine ⟨?_, ?_⟩
      · have hp1 : p ≠ 1 := by
          intro h1; rw [h1, one_nsmul] at hp_ab; exact hab0 hp_ab
        omega
      · intro u hdiv
        rcases hdiv with ⟨v, huv⟩
        have hu_pos : 0 < u := Nat.pos_of_ne_zero fun h0 => by rw [h0, zero_mul] at huv; omega
        have hv_pos : 0 < v := Nat.pos_of_ne_zero fun h0 => by rw [h0, mul_zero] at huv; omega
        have hprod : (u • (a * b)) * (v • (a * b)) = 0 := by
          rw [smul_mul_assoc, mul_smul_comm, ← mul_nsmul', ← huv, hp_all]
        rcases mul_eq_zero.mp hprod with hu0 | hv0
        · have hpu : p ∣ u := hp_dvd_of_nsmul hab0 hu0
          right; exact Nat.dvd_antisymm ⟨v, huv⟩ hpu
        · have hpv : p ∣ v := hp_dvd_of_nsmul hab0 hv0
          have hvp : v = p := Nat.dvd_antisymm ⟨u, by rw [mul_comm]; exact huv⟩ hpv
          left; rw [hvp] at huv
          exact mul_right_cancel₀ hp_pos.ne' (huv.symm.trans (one_mul p).symm)
    have hp_zsmul_all : ∀ (z : ℤ) (y : R), ((p : ℤ) * z) • y = 0 := by
      intro z y
      rw [mul_zsmul, zsmul_comm, natCast_zsmul, hp_all, zsmul_zero]
    have hp_zsmul_eq_zero_iff : ∀ {y : R} {z : ℤ}, y ≠ 0 → (z • y = 0 ↔ (p : ℤ) ∣ z) := by
      intro y z hy
      constructor
      · intro hz
        have hnat : z.natAbs • y = 0 := by
          rcases Int.natAbs_eq z with h | h
          · rw [← natCast_zsmul, ← h, hz]
          · have : -(z.natAbs • y) = 0 := by rw [← natCast_zsmul, ← neg_zsmul, ← h, hz]
            exact neg_eq_zero.mp this
        exact Int.natCast_dvd.mpr (hp_dvd_of_nsmul hy hnat)
      · rintro ⟨q, rfl⟩
        exact hp_zsmul_all q y
    have hp_nsmul_mod : ∀ (k : ℕ) (y : R), k • y = (k % p) • y := by
      intro k y
      conv_lhs => rw [← Nat.div_add_mod k p]
      rw [add_nsmul, mul_nsmul, hp_all, nsmul_zero, zero_add]
    -- Step 3: `p ∤ n` and `p ∤ (n - 1)`.
    have hndvd_n : ¬ (p ∣ n) := by
      intro hdiv
      have : n • (a * b) = 0 := by
        rcases hdiv with ⟨q, rfl⟩; rw [mul_nsmul, hp_all, nsmul_zero]
      rw [hn] at this; exact hba0 this
    have hndvd_n1 : ¬ (p ∣ (n - 1)) := by
      intro hdiv
      have h1 : (n - 1) • (a * b) = 0 := by
        rcases hdiv with ⟨q, hq⟩; rw [hq, mul_nsmul, hp_all, nsmul_zero]
      have h2 : n • (a * b) = a * b := by
        rw [← Nat.sub_add_cancel hn_pos, add_nsmul, h1, zero_add, one_nsmul]
      rw [hn] at h2; exact hne h2.symm
    -- Step 4: `b * a^2 = (n * n) • (a^2 * b)` and apply `(R)` to `(a + a * a, b)`.
    have hba2 : b * (a * a) = (n * n) • (a * a * b) := by
      calc b * (a * a)
          = (b * a) * a := (mul_assoc b a a).symm
        _ = (n • (a * b)) * a := by rw [hn]
        _ = n • (a * (b * a)) := by rw [smul_mul_assoc, mul_assoc]
        _ = n • (a * (n • (a * b))) := by rw [hn]
        _ = (n * n) • (a * a * b) := by rw [mul_smul_comm, ← mul_nsmul', mul_assoc]
    have hcomb_mem : b * (a + a * a) ∈ AddSubmonoid.closure ({(a + a * a) * b} : Set R) := by
      rw [hcyc (a + a * a) b]; exact AddSubmonoid.subset_closure (Set.mem_singleton _)
    obtain ⟨μ, hμ⟩ := (mem_closure_singleton_iff ((a + a * a) * b) (b * (a + a * a))).mp hcomb_mem
    have hrel_b : (((n : ℤ) - (μ : ℤ)) • a + (((n * n : ℕ) : ℤ) - (μ : ℤ)) • (a * a)) * b = 0 := by
      have hexp : n • (a * b) + (n * n) • (a * a * b) = μ • (a * b) + μ • (a * a * b) := by
        calc n • (a * b) + (n * n) • (a * a * b)
            = b * a + b * (a * a) := by rw [hn, hba2]
          _ = b * (a + a * a) := (mul_add b a (a * a)).symm
          _ = μ • ((a + a * a) * b) := hμ.symm
          _ = μ • (a * b) + μ • (a * a * b) := by rw [add_mul, smul_add]
      rw [add_mul, smul_mul_assoc, smul_mul_assoc, sub_zsmul, sub_zsmul]
      simp only [natCast_zsmul]
      calc n • (a * b) + -(μ • (a * b)) + ((n * n) • (a * a * b) + -(μ • (a * a * b)))
          = (n • (a * b) + (n * n) • (a * a * b)) - (μ • (a * b) + μ • (a * a * b)) := by abel
        _ = 0 := by rw [hexp, sub_self]
    have hrel : ((n : ℤ) - (μ : ℤ)) • a + (((n * n : ℕ) : ℤ) - (μ : ℤ)) • (a * a) = 0 :=
      (mul_eq_zero.mp hrel_b).resolve_right hb0
    -- Step 5: The coefficient of `a * a` is not divisible by `p`.
    have hndvd_beta : ¬ ((p : ℤ) ∣ (((n * n : ℕ) : ℤ) - (μ : ℤ))) := by
      intro hbeta
      have hbeta0 : (((n * n : ℕ) : ℤ) - (μ : ℤ)) • (a * a) = 0 :=
        (hp_zsmul_eq_zero_iff (mul_ne_zero ha0 ha0)).mpr hbeta
      rw [hbeta0, add_zero] at hrel
      have halpha : (p : ℤ) ∣ ((n : ℤ) - (μ : ℤ)) := (hp_zsmul_eq_zero_iff ha0).mp hrel
      have hdiff : (p : ℤ) ∣ (((n * n : ℕ) : ℤ) - (n : ℤ)) := by
        have := dvd_sub hbeta halpha
        simpa [sub_sub_sub_cancel_right] using this
      have hfact : (((n * n : ℕ) : ℤ) - (n : ℤ)) = (n : ℤ) * ((n - 1 : ℕ) : ℤ) := by
        rw [Nat.cast_sub hn_pos]; push_cast; ring
      rw [hfact] at hdiff
      have hnat_dvd : p ∣ n * (n - 1) := by exact_mod_cast hdiff
      rcases hp_prime.dvd_mul.mp hnat_dvd with h1 | h2
      · exact hndvd_n h1
      · exact hndvd_n1 h2
    -- Step 6: Extract `a * a = c • a` with `¬ (p ∣ c)`, hence a nonzero idempotent `e` which is `1`.
    have : Fact p.Prime := ⟨hp_prime⟩
    set β : ZMod p := ((((n * n : ℕ) : ℤ) - (μ : ℤ)) : ZMod p)
    set α : ZMod p := (((μ : ℤ) - (n : ℤ)) : ZMod p)
    have hβ_ne : β ≠ 0 := by
      intro h0
      have h0' : ((((n * n : ℕ) : ℤ) - (μ : ℤ) : ℤ) : ZMod p) = 0 := by
        rw [Int.cast_sub, Int.cast_natCast, Int.cast_natCast]
        simpa [β] using h0
      exact hndvd_beta ((ZMod.intCast_zmod_eq_zero_iff_dvd (((n * n : ℕ) : ℤ) - (μ : ℤ)) p).mp h0')
    have h_rel_mod : β.val • (a * a) = α.val • a := by
      have hβ_eq : ((β.val : ℤ) - (((n * n : ℕ) : ℤ) - (μ : ℤ))) • (a * a) = 0 := by
        rw [hp_zsmul_eq_zero_iff (mul_ne_zero ha0 ha0), ← ZMod.intCast_zmod_eq_zero_iff_dvd]
        push_cast; simp [β]
      have hα_eq : ((α.val : ℤ) - ((μ : ℤ) - (n : ℤ))) • a = 0 := by
        rw [hp_zsmul_eq_zero_iff ha0, ← ZMod.intCast_zmod_eq_zero_iff_dvd]
        push_cast; simp [α]
      have h1 : β.val • (a * a) = (((n * n : ℕ) : ℤ) - (μ : ℤ)) • (a * a) := by
        rw [← natCast_zsmul]
        rw [sub_zsmul, ← sub_eq_add_neg] at hβ_eq
        exact sub_eq_zero.mp hβ_eq
      have h2 : α.val • a = ((μ : ℤ) - (n : ℤ)) • a := by
        rw [← natCast_zsmul]
        rw [sub_zsmul, ← sub_eq_add_neg] at hα_eq
        exact sub_eq_zero.mp hα_eq
      rw [h1, h2]
      have hneg : ((μ : ℤ) - (n : ℤ)) • a = -(((n : ℤ) - (μ : ℤ)) • a) := by
        rw [← neg_zsmul, neg_sub]
      rw [hneg]
      exact eq_neg_of_add_eq_zero_right hrel
    set c : ZMod p := β⁻¹ * α
    have haa : a * a = c.val • a := by
      have hmul : (β⁻¹.val * β.val) • (a * a) = (β⁻¹.val * α.val) • a := by
        rw [mul_nsmul', h_rel_mod, ← mul_nsmul']
      have hmod1 : (β⁻¹.val * β.val) % p = 1 % p := by
        have h1 : ((β⁻¹.val * β.val : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) := by
          push_cast; simp [hβ_ne]
        simpa only [ZMod.val_natCast] using congrArg ZMod.val h1
      have hmod2 : (β⁻¹.val * α.val) % p = c.val := by
        have h2 : ((β⁻¹.val * α.val : ℕ) : ZMod p) = c := by
          dsimp [c]; push_cast; simp
        simpa only [ZMod.val_natCast] using congrArg ZMod.val h2
      rw [hp_nsmul_mod, hmod1, ← hp_nsmul_mod, one_nsmul, hp_nsmul_mod, hmod2] at hmul
      exact hmul
    have hc_ne : c ≠ 0 := by
      intro hc0
      rw [hc0, ZMod.val_zero, zero_nsmul] at haa
      exact mul_ne_zero ha0 ha0 haa
    set e : R := c⁻¹.val • a
    have hee : e * e = e := by
      dsimp [e]
      rw [smul_mul_assoc, mul_smul_comm, haa, ← mul_nsmul', ← mul_nsmul', hp_nsmul_mod]
      have hmod : (c⁻¹.val * (c⁻¹.val * c.val)) % p = c⁻¹.val := by
        have h1 : ((c⁻¹.val * (c⁻¹.val * c.val) : ℕ) : ZMod p) = c⁻¹ := by
          push_cast
          rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, inv_mul_cancel₀ hc_ne, mul_one]
        simpa only [ZMod.val_natCast] using congrArg ZMod.val h1
      rw [Nat.mul_assoc, hmod]
    have he0 : e ≠ 0 := by
      intro h0
      have hdiv : p ∣ c⁻¹.val := hp_dvd_of_nsmul ha0 h0
      have hci0 : c⁻¹ = 0 := by
        rw [← ZMod.natCast_zmod_val c⁻¹, ZMod.natCast_eq_zero_iff]
        exact hdiv
      exact (inv_ne_zero hc_ne) hci0
    have he_left : ∀ y : R, e * y = y := by
      intro y
      have h0 : e * (e * y - y) = 0 := by
        rw [mul_sub, ← mul_assoc, hee, sub_self]
      exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_left he0)
    have he_right : ∀ y : R, y * e = y := by
      intro y
      have h0 : (y * e - y) * e = 0 := by
        rw [sub_mul, mul_assoc, hee, sub_self]
      exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right he0)
    have ha_eq_ce : a = c.val • e := by
      dsimp [e]
      rw [← mul_nsmul', hp_nsmul_mod]
      have hmod : (c.val * c⁻¹.val) % p = 1 % p := by
        have h1 : ((c.val * c⁻¹.val : ℕ) : ZMod p) = ((1 : ℕ) : ZMod p) := by
          push_cast; simp [hc_ne]
        simpa only [ZMod.val_natCast] using congrArg ZMod.val h1
      rw [hmod, ← hp_nsmul_mod, one_nsmul]
    have hcomm_ab : a * b = b * a := by
      calc a * b
          = (c.val • e) * b := by rw [ha_eq_ce]
        _ = c.val • (e * b) := smul_mul_assoc _ _ _
        _ = c.val • b := by rw [he_left]
        _ = c.val • (b * e) := by rw [he_right]
        _ = b * (c.val • e) := (mul_smul_comm _ _ _).symm
        _ = b * a := by rw [← ha_eq_ce]
    exact hne hcomm_ab
  · intro hcomm
    rw [submonoidMul_comm_iff]
    intro r s
    rw [hcomm r s]

/-! ### Section 3: Theorem B — 14-Element Noncommutative Semiring Domain `R14` -/

/-- The 14-element semiring `R14 = {0, ∞} ∪ (Z_3 × Z_2^2)` twisted by the asymmetric
bicharacter `β(g, h) = (-1)^(g₁ h₂) ∈ Z_3ˣ`. -/
inductive R14 : Type
  | zero : R14
  | inf : R14
  | elem (i : ZMod 3) (g1 g2 : Bool) : R14
  deriving DecidableEq

namespace R14

/-- Explicit enumeration of all 14 elements of `R14`. -/
def allElems : List R14 :=
  [zero, inf,
   elem 0 false false, elem 1 false false, elem 2 false false,
   elem 0 false true,  elem 1 false true,  elem 2 false true,
   elem 0 true  false, elem 1 true  false, elem 2 true  false,
   elem 0 true  true,  elem 1 true  true,  elem 2 true  true]

instance : Fintype R14 where
  elems := allElems.toFinset
  complete := by
    rintro (_ | _ | ⟨i, g1, g2⟩)
    · decide
    · decide
    · fin_cases i <;> cases g1 <;> cases g2 <;> decide

theorem card_R14 : Fintype.card R14 = 14 := by decide

/-- Addition on `R14`: `0` is neutral, fibre-wise addition in `Z_3`, cross-fibre sums equal `∞`. -/
def add : R14 → R14 → R14
  | zero, y => y
  | x, zero => x
  | inf, _ => inf
  | _, inf => inf
  | elem i g1 g2, elem j h1 h2 =>
      if g1 = h1 ∧ g2 = h2 then elem (i + j) g1 g2 else inf

/-- Twist factor `β((g1, g2), (h1, h2)) = (-1)^(g1 * h2) ∈ Z_3ˣ` (2 if `g1 && h2`, else 1). -/
def beta (g1 h2 : Bool) : ZMod 3 :=
  if g1 && h2 then 2 else 1

/-- Multiplication on `R14`: `0` is absorbing, `∞` absorbs nonzero elements,
`(i, g) * (j, h) = (i * j * β(g, h), g ⊕ h)`. -/
def mul : R14 → R14 → R14
  | zero, _ => zero
  | _, zero => zero
  | inf, _ => inf
  | _, inf => inf
  | elem i g1 g2, elem j h1 h2 =>
      elem (i * j * beta g1 h2) (xor g1 h1) (xor g2 h2)

instance : Zero R14 := ⟨zero⟩
instance : Add R14 := ⟨add⟩
instance : Mul R14 := ⟨mul⟩

private lemma add_zero_r14 (x : R14) : add x zero = x := by cases x <;> rfl
private lemma zero_add_r14 (x : R14) : add zero x = x := by cases x <;> rfl
private lemma mul_zero_r14 (x : R14) : mul x zero = zero := by cases x <;> rfl
private lemma zero_mul_r14 (x : R14) : mul zero x = zero := by cases x <;> rfl

private lemma add_comm_r14 (x y : R14) : add x y = add y x := by
  cases x with
  | zero => cases y <;> rfl
  | inf => cases y <;> rfl
  | elem i g1 g2 =>
    cases y with
    | zero => rfl
    | inf => rfl
    | elem j h1 h2 =>
      simp only [add]
      by_cases h : g1 = h1 ∧ g2 = h2
      · rcases h with ⟨rfl, rfl⟩
        simp [add_comm]
      · have h' : ¬ (h1 = g1 ∧ h2 = g2) := fun ⟨a, b⟩ => h ⟨a.symm, b.symm⟩
        rw [if_neg h, if_neg h']

private lemma add_assoc_r14 (x y z : R14) : add (add x y) z = add x (add y z) := by
  cases x with
  | zero => simp only [add]
  | inf =>
    cases y with
    | zero => rfl
    | inf => cases z <;> rfl
    | elem j h1 h2 =>
      cases z with
      | zero => rfl
      | inf => rfl
      | elem k k1 k2 => simp only [add]; split_ifs <;> rfl
  | elem i g1 g2 =>
    cases y with
    | zero => rfl
    | inf => cases z <;> rfl
    | elem j h1 h2 =>
      cases z with
      | zero => simp only [add]; split_ifs <;> rfl
      | inf => simp only [add]; split_ifs <;> rfl
      | elem k k1 k2 =>
        simp only [add]
        by_cases hgh : g1 = h1 ∧ g2 = h2
        · rcases hgh with ⟨rfl, rfl⟩
          by_cases hgk : g1 = k1 ∧ g2 = k2
          · rcases hgk with ⟨rfl, rfl⟩
            simp [add_assoc]
          · simp [hgk]
        · by_cases hhk : h1 = k1 ∧ h2 = k2
          · rcases hhk with ⟨rfl, rfl⟩
            simp [hgh]
          · simp [hgh, hhk]

private lemma beta_assoc (g1 g2 h1 h2 k1 k2 : Bool) :
    beta g1 h2 * beta (xor g1 h1) k2 = beta g1 (xor h2 k2) * beta h1 k2 := by
  cases g1 <;> cases g2 <;> cases h1 <;> cases h2 <;> cases k1 <;> cases k2 <;> decide

private lemma mul_assoc_r14 (x y z : R14) : mul (mul x y) z = mul x (mul y z) := by
  cases x with
  | zero => cases y <;> cases z <;> rfl
  | inf => cases y <;> cases z <;> rfl
  | elem i g1 g2 =>
    cases y with
    | zero => cases z <;> rfl
    | inf => cases z <;> rfl
    | elem j h1 h2 =>
      cases z with
      | zero => rfl
      | inf => rfl
      | elem k k1 k2 =>
        simp only [mul]
        congr 1
        · calc i * j * beta g1 h2 * k * beta (xor g1 h1) k2
              = i * j * k * (beta g1 h2 * beta (xor g1 h1) k2) := by ring
            _ = i * j * k * (beta g1 (xor h2 k2) * beta h1 k2) := by rw [beta_assoc g1 g2 h1 h2 k1 k2]
            _ = i * (j * k * beta h1 k2) * beta g1 (xor h2 k2) := by ring
        · cases g1 <;> cases h1 <;> cases k1 <;> rfl
        · cases g2 <;> cases h2 <;> cases k2 <;> rfl

private lemma left_distrib_r14 (x y z : R14) : mul x (add y z) = add (mul x y) (mul x z) := by
  cases x with
  | zero => simp only [mul, add]
  | inf =>
    cases y with
    | zero => cases z <;> rfl
    | inf => cases z <;> rfl
    | elem j h1 h2 =>
      cases z with
      | zero => rfl
      | inf => rfl
      | elem k k1 k2 => simp only [add, mul]; split_ifs <;> rfl
  | elem i g1 g2 =>
    cases y with
    | zero => cases z <;> rfl
    | inf => cases z <;> rfl
    | elem j h1 h2 =>
      cases z with
      | zero => rfl
      | inf => rfl
      | elem k k1 k2 =>
        simp only [add, mul]
        have hiff : (xor g1 h1 = xor g1 k1 ∧ xor g2 h2 = xor g2 k2) ↔ (h1 = k1 ∧ h2 = k2) := by
          cases g1 <;> cases g2 <;> cases h1 <;> cases h2 <;> cases k1 <;> cases k2 <;> decide
        by_cases h : h1 = k1 ∧ h2 = k2
        · rcases h with ⟨rfl, rfl⟩
          simp only [and_self, ↓reduceIte]
          congr 1; ring
        · rw [if_neg h, if_neg (fun h' => h (hiff.mp h'))]

private lemma right_distrib_r14 (x y z : R14) : mul (add x y) z = add (mul x z) (mul y z) := by
  cases z with
  | zero =>
    cases x <;> cases y <;> simp only [add, mul]
    split_ifs <;> rfl
  | inf =>
    cases x with
    | zero => cases y <;> rfl
    | inf => cases y <;> rfl
    | elem i g1 g2 =>
      cases y with
      | zero => rfl
      | inf => rfl
      | elem j h1 h2 => simp only [add, mul]; split_ifs <;> rfl
  | elem k k1 k2 =>
    cases x with
    | zero => cases y <;> rfl
    | inf => cases y <;> rfl
    | elem i g1 g2 =>
      cases y with
      | zero => rfl
      | inf => rfl
      | elem j h1 h2 =>
        simp only [add, mul]
        have hiff : (xor g1 k1 = xor h1 k1 ∧ xor g2 k2 = xor h2 k2) ↔ (g1 = h1 ∧ g2 = h2) := by
          cases g1 <;> cases g2 <;> cases h1 <;> cases h2 <;> cases k1 <;> cases k2 <;> decide
        by_cases h : g1 = h1 ∧ g2 = h2
        · rcases h with ⟨rfl, rfl⟩
          simp only [and_self, ↓reduceIte]
          congr 1; ring
        · rw [if_neg h, if_neg (fun h' => h (hiff.mp h'))]

instance : NonUnitalSemiring R14 where
  add := add
  add_assoc := add_assoc_r14
  zero := zero
  zero_add := zero_add_r14
  add_zero := add_zero_r14
  nsmul := nsmulRec
  add_comm := add_comm_r14
  mul := mul
  left_distrib := left_distrib_r14
  right_distrib := right_distrib_r14
  zero_mul := zero_mul_r14
  mul_zero := mul_zero_r14
  mul_assoc := mul_assoc_r14

instance : Nontrivial R14 := ⟨⟨zero, inf, by decide⟩⟩

instance : NoZeroDivisors R14 where
  eq_zero_or_eq_zero_of_mul_eq_zero := by
    intro x y h
    cases x with
    | zero => left; rfl
    | inf =>
      cases y with
      | zero => right; rfl
      | inf => cases h
      | elem _ _ _ => cases h
    | elem _ _ _ =>
      cases y with
      | zero => right; rfl
      | inf => cases h
      | elem _ _ _ => cases h

/-- `R14` is noncommutative: `(1, (1,0)) * (1, (0,1)) = (2, (1,1)) ≠ (1, (1,1)) = (1, (0,1)) * (1, (1,0))`. -/
theorem R14_not_comm : ¬ ∀ a b : R14, a * b = b * a := by
  intro hcomm
  have h := hcomm (elem 1 true false) (elem 1 false true)
  exact absurd h (by decide)

private lemma elem_twice (i : ZMod 3) (g1 g2 : Bool) :
    (2 : ℕ) • elem i g1 g2 = elem (2 * i) g1 g2 := by
  change add (add zero (elem i g1 g2)) (elem i g1 g2) = elem (2 * i) g1 g2
  simp only [add, and_self, ↓reduceIte]
  congr 1; ring

/-- Every pair `r, s ∈ R14` satisfies `⟨r * s⟩ = ⟨s * r⟩`, so `M(R14)` is commutative! -/
theorem R14_quantale_comm : quantaleCommutative R14 := by
  rw [submonoidMul_comm_iff]
  have hle : ∀ r s : R14, AddSubmonoid.closure ({r * s} : Set R14) ≤ AddSubmonoid.closure ({s * r} : Set R14) := by
    intro r s
    rw [AddSubmonoid.closure_le]
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    change r * s ∈ AddSubmonoid.closure ({s * r} : Set R14)
    rw [mem_closure_singleton_iff]
    cases r with
    | zero => exact ⟨1, by cases s <;> rfl⟩
    | inf => exact ⟨1, by cases s <;> rfl⟩
    | elem i g1 g2 =>
      cases s with
      | zero => exact ⟨1, rfl⟩
      | inf => exact ⟨1, rfl⟩
      | elem j h1 h2 =>
        by_cases heq : beta g1 h2 = beta h1 g2
        · refine ⟨1, ?_⟩
          rw [one_nsmul]
          change elem (j * i * beta h1 g2) (xor h1 g1) (xor h2 g2) =
            elem (i * j * beta g1 h2) (xor g1 h1) (xor g2 h2)
          rw [heq, mul_comm j i, Bool.xor_comm h1 g1, Bool.xor_comm h2 g2]
        · refine ⟨2, ?_⟩
          change (2 : ℕ) • elem (j * i * beta h1 g2) (xor h1 g1) (xor h2 g2) =
            elem (i * j * beta g1 h2) (xor g1 h1) (xor g2 h2)
          rw [elem_twice, Bool.xor_comm h1 g1, Bool.xor_comm h2 g2]
          congr 1
          have h2b : (2 : ZMod 3) * beta h1 g2 = beta g1 h2 := by
            revert heq; cases g1 <;> cases g2 <;> cases h1 <;> cases h2 <;> decide
          calc 2 * (j * i * beta h1 g2) = i * j * (2 * beta h1 g2) := by ring
            _ = i * j * beta g1 h2 := by rw [h2b]
  intro r s
  exact le_antisymm (hle r s) (hle s r)

/-- **Theorem B (Negative answer to Question 34 for semiring domains):**
`R14` is a 14-element noncommutative semiring domain whose submonoid quantale `M(R14)` is commutative. -/
theorem mesyan_Q34_semirings_counterexample :
    Fintype.card R14 = 14 ∧
    (∃ a b : R14, a * b ≠ b * a) ∧
    quantaleCommutative R14 :=
  ⟨card_R14, ⟨elem 1 true false, elem 1 false true, by decide⟩, R14_quantale_comm⟩

end R14

end MesyanSubmonoidQuantale
