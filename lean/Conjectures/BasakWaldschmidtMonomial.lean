import Mathlib

/-!
# Negative Answer to Basak–Bijender–Kumar Question 4.14 (`arXiv:2611.19424v1`)

This module disproves Question 4.14 of Basak, Bijender, and Kumar
(*On the Waldschmidt constant of monomial ideals*, `arXiv:2611.19424v1`, 14 Nov 2026),
which asks whether every monomial ideal `I` of big-height `e` satisfies
`α̂(I) ≥ (α(I) + e - 1) / (e + 1)`.

For every pair of integers `T ≥ 4` and `r ≥ 1` satisfying `r * (T - 3) > T * (T - 1)`,
let `B = Comp T r = { b : Fin r → Fin T | ∑ j, b j = T - 1 }`. Over any field `K`, in
`R = MvPolynomial (Fin r ⊕ Comp T r) K`, we define
`q_b = (x_1^(b_1+1), …, x_r^(b_r+1), y_b)` and `I = ⨅ b : Comp T r, q_b`.

## Main Theorems

* `compIdeal_pow_eq_monIdeal`: exact monomial membership characterization of `q_b^m`.
* `primeIdeal_isPrime`, `compIdeal_pow_isPrimary`, `compIdeal_pow_radical`:
  `P_b = (x_1, …, x_r, y_b)` is prime (generated by `r + 1` distinct variables), and
  `q_b^m` is `P_b`-primary for every `m ≥ 1`.
* `irredundant_decomposition` and `minimalPrimes_eq`:
  `I = ⨅ b, q_b` is an irredundant primary decomposition with `Min(I) = { P_b | b ∈ B }`.
* `symbolicPower_localization_eq`: for every `b ∈ B` and `m ≥ 1`,
  `I^m R_{P_b} ∩ R = q_b^m`, so `I^(m) = ⨅ b, q_b^m`.
* `initialDeg_I_eq`: `α(I) = T`.
* `initialDeg_symbolicPower_lower` and `initialDeg_symbolicPower_upper`:
  `(2r / (2r - T + 1)) * m ≤ α(I^(m))` for all `m ≥ 1`, and
  `α(I^((2r - T + 1)k)) ≤ 2rk` for all `k ≥ 1`.
* `waldschmidt_tendsto` and `waldschmidt_strict_counterexample`:
  `lim_{m→∞} α(I^(m))/m = 2r / (2r - T + 1) < (α(I) + e - 1) / (e + 1)` with `e = r + 1`.
* `headline_counterexample_4_13`: explicit instantiation `(T, r) = (4, 13)` with
  `|B| = 455`, `α(I) = 4`, `e = 14`, and `α̂(I) = 26 / 23 < 17 / 15`.
-/

namespace BasakWaldschmidtMonomial

open MvPolynomial Finset

/-! ### Core definitions -/

/-- Index set `B = { b ∈ ℕ^r : ∑ j, b j = T - 1 }` encoded using `Fin T` for automatic `Fintype`. -/
abbrev Comp (T r : ℕ) := { b : Fin r → Fin T // ∑ j : Fin r, (b j).val = T - 1 }

/-- Variable type `x_1, …, x_r` (`Sum.inl`) together with `y_b` for `b ∈ B` (`Sum.inr`). -/
abbrev Var (T r : ℕ) := Fin r ⊕ Comp T r

variable {T r : ℕ} {K : Type*} [Field K]

/-- Indeterminate `x_j`. -/
noncomputable def xVar (j : Fin r) : MvPolynomial (Var T r) K :=
  MvPolynomial.X (Sum.inl j)

/-- Indeterminate `y_b`. -/
noncomputable def yVar (b : Comp T r) : MvPolynomial (Var T r) K :=
  MvPolynomial.X (Sum.inr b)

/-- Prime ideal `P_b = (x_1, …, x_r, y_b)` of height `r + 1`. -/
noncomputable def primeIdeal (b : Comp T r) : Ideal (MvPolynomial (Var T r) K) :=
  Ideal.span (Set.range (xVar (T := T) (r := r) (K := K)) ∪ {yVar b})

/-- Primary component `q_b = (x_1^(b_1+1), …, x_r^(b_r+1), y_b)`. -/
noncomputable def compIdeal (b : Comp T r) : Ideal (MvPolynomial (Var T r) K) :=
  Ideal.span (Set.range (fun j : Fin r => (xVar (T := T) (r := r) (K := K) j) ^ ((b.val j).val + 1)) ∪ {yVar b})

/-- The counterexample monomial ideal `I = ⨅ b : Comp T r, q_b`. -/
noncomputable def counterIdeal (T r : ℕ) (K : Type*) [Field K] : Ideal (MvPolynomial (Var T r) K) :=
  ⨅ b : Comp T r, compIdeal b

/-- Initial degree `α(J) = min { totalDegree f | f ∈ J, f ≠ 0 }`. -/
noncomputable def initialDeg {σ : Type*} (J : Ideal (MvPolynomial σ K)) : ℕ :=
  sInf { d : ℕ | ∃ f ∈ J, f ≠ 0 ∧ f.totalDegree = d }

/-- Monomial exponent degree `|d| = ∑ v, d v`. -/
def monDeg {σ : Type*} (d : σ →₀ ℕ) : ℕ :=
  d.sum (fun _ k => k)

/-- `(x, y_b)`-degree weight of a monomial exponent `d`. -/
def weightB (b : Comp T r) : (Var T r →₀ ℕ) →+ ℕ where
  toFun d := (∑ j : Fin r, d (Sum.inl j)) + d (Sum.inr b)
  map_zero' := by simp
  map_add' d₁ d₂ := by
    simp only [Finsupp.coe_add, Pi.add_apply, Finset.sum_add_distrib]
    omega

/-- Monomial criterion for membership in `q_b^m`: `∑_j ⌊c_j / (b_j + 1)⌋ + d_b ≥ m`. -/
def inQm (b : Comp T r) (m : ℕ) (d : Var T r →₀ ℕ) : Prop :=
  m ≤ (∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1)) + d (Sum.inr b)

/-- Explicit monomial ideal `J_{b, m}` of polynomials supported on exponents satisfying `inQm b m`. -/
noncomputable def monIdeal (b : Comp T r) (m : ℕ) : Ideal (MvPolynomial (Var T r) K) where
  carrier := { f | ∀ d ∈ f.support, inQm b m d }
  add_mem' {f g} hf hg d hd := by
    rcases Finset.mem_union.mp (MvPolynomial.support_add hd) with h1 | h2
    · exact hf d h1
    · exact hg d h2
  zero_mem' d hd := by simp at hd
  smul_mem' c {f} hf d hd := by
    rw [smul_eq_mul, MvPolynomial.mem_support_iff, MvPolynomial.coeff_mul] at hd
    obtain ⟨p, hp_mem, hp_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp_mem
    have h2 : p.2 ∈ f.support := by
      rw [MvPolynomial.mem_support_iff]
      intro h0; simp [h0] at hp_ne
    have hin := hf p.2 h2
    unfold inQm at hin ⊢
    have hle_sum : ∑ j : Fin r, p.2 (Sum.inl j) / ((b.val j).val + 1) ≤
        ∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1) := by
      apply Finset.sum_le_sum
      intro j _
      apply Nat.div_le_div_right
      rw [← hp_mem]; simp
    have hle_y : p.2 (Sum.inr b) ≤ d (Sum.inr b) := by
      rw [← hp_mem]; simp
    omega

/-- Explicit monomial ideal `P'_b` of polynomials supported on exponents with `weightB b d ≥ 1`. -/
noncomputable def primeMonIdeal (b : Comp T r) : Ideal (MvPolynomial (Var T r) K) where
  carrier := { f | ∀ d ∈ f.support, 1 ≤ weightB b d }
  add_mem' {f g} hf hg d hd := by
    rcases Finset.mem_union.mp (MvPolynomial.support_add hd) with h1 | h2
    · exact hf d h1
    · exact hg d h2
  zero_mem' d hd := by simp at hd
  smul_mem' c {f} hf d hd := by
    rw [smul_eq_mul, MvPolynomial.mem_support_iff, MvPolynomial.coeff_mul] at hd
    obtain ⟨p, hp_mem, hp_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp_mem
    have h2 : p.2 ∈ f.support := by
      rw [MvPolynomial.mem_support_iff]
      intro h0; simp [h0] at hp_ne
    have hin := hf p.2 h2
    have hw : weightB b d = weightB b p.1 + weightB b p.2 := by
      rw [← hp_mem, map_add]
    omega

/-! ### Section 1: Monomial membership in `q_b^m` and `P_b` (Lemma 2.1) -/

private lemma add_div_ge_div_add_div (a c w : ℕ) (hw : 0 < w) :
    a / w + c / w ≤ (a + c) / w := by
  rw [Nat.le_div_iff_mul_le hw, add_mul]
  exact Nat.add_le_add (Nat.div_mul_le_self a w) (Nat.div_mul_le_self c w)

private lemma monIdeal_mul_le (b : Comp T r) (m₁ m₂ : ℕ) :
    (monIdeal (K := K) b m₁) * (monIdeal (K := K) b m₂) ≤ monIdeal (K := K) b (m₁ + m₂) := by
  rw [Ideal.mul_le]
  intro f hf g hg d hd
  rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_mul] at hd
  obtain ⟨p, hp_mem, hp_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
  rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp_mem
  have h1 : p.1 ∈ f.support := by
    rw [MvPolynomial.mem_support_iff]; intro h0; simp [h0] at hp_ne
  have h2 : p.2 ∈ g.support := by
    rw [MvPolynomial.mem_support_iff]; intro h0; simp [h0] at hp_ne
  have hin1 := hf p.1 h1
  have hin2 := hg p.2 h2
  unfold inQm at hin1 hin2 ⊢
  have hsum : (∑ j : Fin r, p.1 (Sum.inl j) / ((b.val j).val + 1)) +
      (∑ j : Fin r, p.2 (Sum.inl j) / ((b.val j).val + 1)) ≤
      ∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1) := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro j _
    rw [← hp_mem, Finsupp.coe_add, Pi.add_apply]
    exact add_div_ge_div_add_div _ _ _ (Nat.succ_pos _)
  have hy : p.1 (Sum.inr b) + p.2 (Sum.inr b) = d (Sum.inr b) := by
    rw [← hp_mem, Finsupp.coe_add, Pi.add_apply]
  omega

private lemma mem_compIdeal_of_xpow (b : Comp T r) (j : Fin r) :
    (xVar (T := T) (r := r) (K := K) j) ^ ((b.val j).val + 1) ∈ compIdeal (K := K) b :=
  Ideal.subset_span (Or.inl ⟨j, rfl⟩)

private lemma mem_compIdeal_of_y (b : Comp T r) :
    (yVar (T := T) (r := r) (K := K) b) ∈ compIdeal (K := K) b :=
  Ideal.subset_span (Or.inr rfl)

private lemma compIdeal_le_monIdeal_one (b : Comp T r) :
    compIdeal (K := K) b ≤ monIdeal (K := K) b 1 := by
  rw [compIdeal, Ideal.span_le]
  rintro f (⟨j, rfl⟩ | rfl)
  · intro d hd
    dsimp only at hd
    have hpow : (xVar (T := T) (r := r) (K := K) j) ^ ((b.val j).val + 1) =
        MvPolynomial.monomial (Finsupp.single (Sum.inl j) ((b.val j).val + 1)) (1 : K) := by
      simp [xVar, MvPolynomial.X_pow_eq_monomial]
    rw [hpow] at hd
    have hdeq : d = Finsupp.single (Sum.inl j) ((b.val j).val + 1) := by
      have hsub := MvPolynomial.support_monomial_subset hd
      exact Finset.mem_singleton.mp hsub
    subst hdeq
    unfold inQm
    have hterm : 1 ≤ (Finsupp.single (Sum.inl j : Var T r) ((b.val j).val + 1)) (Sum.inl j) /
        ((b.val j).val + 1) := by
      simp [Nat.div_self (Nat.succ_pos _)]
    have hle : (Finsupp.single (Sum.inl j : Var T r) ((b.val j).val + 1)) (Sum.inl j) /
        ((b.val j).val + 1) ≤
        ∑ i : Fin r, (Finsupp.single (Sum.inl j : Var T r) ((b.val j).val + 1)) (Sum.inl i) /
          ((b.val i).val + 1) :=
      Finset.single_le_sum (f := fun i : Fin r =>
          (Finsupp.single (Sum.inl j : Var T r) ((b.val j).val + 1)) (Sum.inl i) / ((b.val i).val + 1))
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    omega
  · intro d hd
    have hdeq : d = Finsupp.single (Sum.inr b) 1 := by
      have : Finsupp.single (Sum.inr b : Var T r) 1 = d := by simpa [yVar, MvPolynomial.X] using hd
      exact this.symm
    subst hdeq
    unfold inQm
    simp

private lemma monomial_one_mem_compIdeal_pow (b : Comp T r) :
    ∀ (m : ℕ) (d : Var T r →₀ ℕ), inQm b m d →
      MvPolynomial.monomial d (1 : K) ∈ (compIdeal (K := K) b) ^ m := by
  intro m
  induction m with
  | zero =>
    intro d _
    rw [pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  | succ m ih =>
    intro d hd
    unfold inQm at hd
    by_cases hy : 1 ≤ d (Sum.inr b)
    · let d' : Var T r →₀ ℕ := d - Finsupp.single (Sum.inr b) 1
      have hadd : d' + Finsupp.single (Sum.inr b) 1 = d := by
        ext v
        simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply]
        by_cases hv : v = Sum.inr b
        · subst hv; simp; omega
        · rw [Finsupp.single_eq_of_ne hv]; omega
      have hd' : inQm b m d' := by
        unfold inQm
        have hsum : ∑ j : Fin r, d' (Sum.inl j) / ((b.val j).val + 1) =
            ∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1) := by
          apply Finset.sum_congr rfl
          intro j _
          simp only [d', Finsupp.tsub_apply]
          rw [Finsupp.single_eq_of_ne (by simp)]; simp
        have hdy : d' (Sum.inr b) = d (Sum.inr b) - 1 := by
          simp [d', Finsupp.tsub_apply]
        omega
      have hmem1 : MvPolynomial.monomial d' (1 : K) ∈ (compIdeal (K := K) b) ^ m := ih d' hd'
      have hmem2 : MvPolynomial.monomial (Finsupp.single (Sum.inr b) 1) (1 : K) ∈ compIdeal (K := K) b := by
        simpa [yVar, MvPolynomial.X] using mem_compIdeal_of_y (K := K) b
      have hmul : MvPolynomial.monomial d (1 : K) =
          MvPolynomial.monomial d' (1 : K) * MvPolynomial.monomial (Finsupp.single (Sum.inr b) 1) (1 : K) := by
        rw [MvPolynomial.monomial_mul, one_mul, hadd]
      rw [hmul, pow_succ]
      exact Ideal.mul_mem_mul hmem1 hmem2
    · have hsum_pos : 0 < ∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1) := by omega
      have hex_j : ∃ j : Fin r, 1 ≤ d (Sum.inl j) / ((b.val j).val + 1) := by
        by_contra hno
        push Not at hno
        have hzero : ∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1) = 0 := by
          apply Finset.sum_eq_zero
          intro j _
          exact Nat.lt_one_iff.mp (hno j)
        omega
      obtain ⟨j₀, hj₀⟩ := hex_j
      have hge_w : (b.val j₀).val + 1 ≤ d (Sum.inl j₀) := by
        have := (Nat.le_div_iff_mul_le (Nat.succ_pos _)).mp hj₀
        omega
      let w := (b.val j₀).val + 1
      let d' : Var T r →₀ ℕ := d - Finsupp.single (Sum.inl j₀) w
      have hadd : d' + Finsupp.single (Sum.inl j₀) w = d := by
        ext v
        simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply]
        by_cases hv : v = Sum.inl j₀
        · subst hv; simp [w]; omega
        · rw [Finsupp.single_eq_of_ne hv]; omega
      have hd' : inQm b m d' := by
        unfold inQm
        have hsum_drop : (∑ j : Fin r, d' (Sum.inl j) / ((b.val j).val + 1)) + 1 =
            ∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1) := by
          rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j₀),
            ← Finset.add_sum_erase _ _ (Finset.mem_univ j₀)]
          have hrest : ∑ j ∈ Finset.univ.erase j₀, d' (Sum.inl j) / ((b.val j).val + 1) =
              ∑ j ∈ Finset.univ.erase j₀, d (Sum.inl j) / ((b.val j).val + 1) := by
            apply Finset.sum_congr rfl
            intro j hj
            have hne : j ≠ j₀ := (Finset.mem_erase.mp hj).1
            simp only [d', Finsupp.tsub_apply]
            rw [Finsupp.single_eq_of_ne (show (Sum.inl j : Var T r) ≠ Sum.inl j₀ from fun h => hne (Sum.inl.inj h))]
            simp
          have hj0_eq : d' (Sum.inl j₀) / w + 1 = d (Sum.inl j₀) / w := by
            have hsub : d' (Sum.inl j₀) = d (Sum.inl j₀) - w := by simp [d', Finsupp.tsub_apply]
            rw [hsub]
            have h1 : d (Sum.inl j₀) = (d (Sum.inl j₀) - w) + w := by omega
            conv_rhs => rw [h1]
            rw [Nat.add_div_right _ (Nat.succ_pos _)]
          rw [hrest]
          dsimp only [w] at hj0_eq
          omega
        have hdy : d' (Sum.inr b) = d (Sum.inr b) := by
          simp only [d', Finsupp.tsub_apply]
          rw [Finsupp.single_eq_of_ne (by simp)]; simp
        omega
      have hmem1 : MvPolynomial.monomial d' (1 : K) ∈ (compIdeal (K := K) b) ^ m := ih d' hd'
      have hmem2 : MvPolynomial.monomial (Finsupp.single (Sum.inl j₀) w) (1 : K) ∈ compIdeal (K := K) b := by
        have hpow : (xVar (T := T) (r := r) (K := K) j₀) ^ w =
            MvPolynomial.monomial (Finsupp.single (Sum.inl j₀) w) (1 : K) := by
          simp [xVar, MvPolynomial.X_pow_eq_monomial]
        rw [← hpow]
        exact mem_compIdeal_of_xpow (K := K) b j₀
      have hmul : MvPolynomial.monomial d (1 : K) =
          MvPolynomial.monomial d' (1 : K) * MvPolynomial.monomial (Finsupp.single (Sum.inl j₀) w) (1 : K) := by
        rw [MvPolynomial.monomial_mul, one_mul, hadd]
      rw [hmul, pow_succ]
      exact Ideal.mul_mem_mul hmem1 hmem2

/-- **Lemma 2.1:** `q_b^m` equals the exact monomial ideal `monIdeal b m`. -/
theorem compIdeal_pow_eq_monIdeal (b : Comp T r) (m : ℕ) :
    (compIdeal (K := K) b) ^ m = monIdeal (K := K) b m := by
  apply le_antisymm
  · induction m with
    | zero =>
      intro f _ d _
      unfold inQm; omega
    | succ m ih =>
      rw [pow_succ]
      exact le_trans (Ideal.mul_mono ih (compIdeal_le_monIdeal_one b)) (monIdeal_mul_le b m 1)
  · intro f hf
    rw [f.as_sum]
    apply Ideal.sum_mem
    intro d hd
    have h1 := monomial_one_mem_compIdeal_pow (K := K) b m d (hf d hd)
    have hmul : MvPolynomial.monomial d (MvPolynomial.coeff d f) =
        MvPolynomial.C (MvPolynomial.coeff d f) * MvPolynomial.monomial d (1 : K) := by
      rw [MvPolynomial.C_mul_monomial, mul_one]
    rw [hmul]
    exact Ideal.mul_mem_left _ _ h1

/-- Exact monomial characterization of `P_b = (x_1, …, x_r, y_b)`. -/
theorem primeIdeal_eq_primeMonIdeal (b : Comp T r) :
    primeIdeal (K := K) b = primeMonIdeal (K := K) b := by
  apply le_antisymm
  · rw [primeIdeal, Ideal.span_le]
    rintro f (⟨j, rfl⟩ | rfl)
    · intro d hd
      have hdeq : d = Finsupp.single (Sum.inl j) 1 := by
        have : Finsupp.single (Sum.inl j : Var T r) 1 = d := by simpa [xVar, MvPolynomial.X] using hd
        exact this.symm
      subst hdeq
      have hle : (Finsupp.single (Sum.inl j : Var T r) 1) (Sum.inl j) ≤
          ∑ i : Fin r, (Finsupp.single (Sum.inl j : Var T r) 1) (Sum.inl i) :=
        Finset.single_le_sum (f := fun i : Fin r => (Finsupp.single (Sum.inl j : Var T r) 1) (Sum.inl i))
          (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
      simp only [weightB, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Finsupp.single_eq_same] at hle ⊢
      omega
    · intro d hd
      have hdeq : d = Finsupp.single (Sum.inr b) 1 := by
        have : Finsupp.single (Sum.inr b : Var T r) 1 = d := by simpa [yVar, MvPolynomial.X] using hd
        exact this.symm
      subst hdeq
      simp [weightB]
  · intro f hf
    rw [f.as_sum]
    apply Ideal.sum_mem
    intro d hd
    have hw := hf d hd
    have hmul : MvPolynomial.monomial d (MvPolynomial.coeff d f) =
        MvPolynomial.C (MvPolynomial.coeff d f) * MvPolynomial.monomial d (1 : K) := by
      rw [MvPolynomial.C_mul_monomial, mul_one]
    rw [hmul]
    apply Ideal.mul_mem_left
    by_cases hy : 1 ≤ d (Sum.inr b)
    · let d' : Var T r →₀ ℕ := d - Finsupp.single (Sum.inr b) 1
      have hadd : d' + Finsupp.single (Sum.inr b) 1 = d := by
        ext v; simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply]
        by_cases hv : v = Sum.inr b
        · subst hv; simp; omega
        · rw [Finsupp.single_eq_of_ne hv]; omega
      have hmul' : MvPolynomial.monomial d (1 : K) =
          MvPolynomial.monomial d' (1 : K) * yVar b := by
        rw [yVar, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul, hadd]
      rw [hmul']
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inr rfl))
    · have hsum_pos : 0 < ∑ j : Fin r, d (Sum.inl j) := by
        simp only [weightB, AddMonoidHom.coe_mk, ZeroHom.coe_mk] at hw; omega
      obtain ⟨j₀, _, hj₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero (Nat.ne_of_gt hsum_pos)
      let d' : Var T r →₀ ℕ := d - Finsupp.single (Sum.inl j₀) 1
      have hadd : d' + Finsupp.single (Sum.inl j₀) 1 = d := by
        ext v; simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply]
        by_cases hv : v = Sum.inl j₀
        · subst hv; simp; omega
        · rw [Finsupp.single_eq_of_ne hv]; omega
      have hmul' : MvPolynomial.monomial d (1 : K) =
          MvPolynomial.monomial d' (1 : K) * xVar j₀ := by
        rw [xVar, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul, hadd]
      rw [hmul']
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inl ⟨j₀, rfl⟩))

/-! ### Section 2: Primary decomposition, big-height, and symbolic powers (Lemma 2.2) -/

/-- Base-`M` encoding uniqueness on finite tuples with entries `< M`. -/
private lemma base_encoding_inj {N M : ℕ} (hM : 1 ≤ M) {u v : Fin N → ℕ}
    (hu : ∀ i, u i < M) (hv : ∀ i, v i < M)
    (hsum : ∑ i : Fin N, u i * M ^ i.val = ∑ i : Fin N, v i * M ^ i.val) :
    u = v := by
  induction N with
  | zero => ext i; exact i.elim0
  | succ N ih =>
    have hsplit : ∀ w : Fin (N + 1) → ℕ,
        ∑ i : Fin (N + 1), w i * M ^ i.val =
          w 0 + M * ∑ i : Fin N, w i.succ * M ^ i.val := by
      intro w
      rw [Fin.sum_univ_succ]
      simp only [Fin.val_zero, pow_zero, mul_one, Fin.val_succ, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [pow_succ]; ring
    rw [hsplit u, hsplit v] at hsum
    have h0 : u 0 = v 0 := by
      have hmod := congrArg (· % M) hsum
      rw [Nat.add_mul_mod_self_left, Nat.add_mul_mod_self_left,
        Nat.mod_eq_of_lt (hu 0), Nat.mod_eq_of_lt (hv 0)] at hmod
      exact hmod
    have hrest : ∑ i : Fin N, u i.succ * M ^ i.val = ∑ i : Fin N, v i.succ * M ^ i.val := by
      have hmul : M * ∑ i : Fin N, u i.succ * M ^ i.val = M * ∑ i : Fin N, v i.succ * M ^ i.val := by
        omega
      exact Nat.eq_of_mul_eq_mul_left hM hmul
    have htail := ih (fun i => hu i.succ) (fun i => hv i.succ) hrest
    ext i
    refine Fin.cases h0 (fun j => congrFun htail j) i

/-- Key non-cancellation lemma: if `f ≠ 0` and `g` has a term of `weightB b`-degree `0`,
then `f * g` has a nonzero term `d₁ + d₂` with `d₁ ∈ f.support`, `d₂ ∈ g.support`, `weightB b d₂ = 0`. -/
private lemma exists_noncancelling_mul_term {σ : Type*} [Fintype σ] [DecidableEq σ]
    (w : (σ →₀ ℕ) →+ ℕ) {f g : MvPolynomial σ K}
    (hf : f ≠ 0) (hg : ∃ d ∈ g.support, w d = 0) :
    ∃ d₁ ∈ f.support, ∃ d₂ ∈ g.support, w d₂ = 0 ∧ d₁ + d₂ ∈ (f * g).support := by
  have hf_ne : f.support.Nonempty := MvPolynomial.support_nonempty.mpr hf
  obtain ⟨d₀, hd₀_mem, hd₀_min⟩ := Finset.exists_min_image f.support w hf_ne
  set δ := w d₀
  let Sf := f.support.filter (fun d => w d = δ)
  let Sg := g.support.filter (fun d => w d = 0)
  have hSf_ne : Sf.Nonempty := ⟨d₀, Finset.mem_filter.mpr ⟨hd₀_mem, rfl⟩⟩
  obtain ⟨dg0, hdg0_mem, hdg0_w⟩ := hg
  have hSg_ne : Sg.Nonempty := ⟨dg0, Finset.mem_filter.mpr ⟨hdg0_mem, hdg0_w⟩⟩
  let e : σ ≃ Fin (Fintype.card σ) := Fintype.equivFin σ
  let M : ℕ := 1 + (Sf ∪ Sg).sup (fun d => Finset.univ.sup (fun i : Fin (Fintype.card σ) => d (e.symm i)))
  have hM : 1 ≤ M := by omega
  have hltM : ∀ d ∈ Sf ∪ Sg, ∀ i : Fin (Fintype.card σ), d (e.symm i) < M := by
    intro d hd i
    have h1 : d (e.symm i) ≤ Finset.univ.sup (fun i => d (e.symm i)) :=
      Finset.le_sup (f := fun i => d (e.symm i)) (Finset.mem_univ i)
    have h2 : Finset.univ.sup (fun i => d (e.symm i)) ≤
        (Sf ∪ Sg).sup (fun d => Finset.univ.sup (fun i => d (e.symm i))) :=
      Finset.le_sup (f := fun d => Finset.univ.sup (fun i => d (e.symm i))) hd
    omega
  let φ : (σ →₀ ℕ) → ℕ := fun d => ∑ i : Fin (Fintype.card σ), d (e.symm i) * M ^ i.val
  have hφ_add : ∀ a c, φ (a + c) = φ a + φ c := by
    intro a c
    simp only [φ, Finsupp.coe_add, Pi.add_apply, add_mul, Finset.sum_add_distrib]
  obtain ⟨d₁, hd₁_Sf, hd₁_max⟩ := Finset.exists_max_image Sf φ hSf_ne
  obtain ⟨d₂, hd₂_Sg, hd₂_max⟩ := Finset.exists_max_image Sg φ hSg_ne
  have hd₁_f : d₁ ∈ f.support := (Finset.mem_filter.mp hd₁_Sf).1
  have hd₁_w : w d₁ = δ := (Finset.mem_filter.mp hd₁_Sf).2
  have hd₂_g : d₂ ∈ g.support := (Finset.mem_filter.mp hd₂_Sg).1
  have hd₂_w : w d₂ = 0 := (Finset.mem_filter.mp hd₂_Sg).2
  refine ⟨d₁, hd₁_f, d₂, hd₂_g, hd₂_w, ?_⟩
  rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_mul]
  have hsingle : ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d₁ + d₂),
      MvPolynomial.coeff p.1 f * MvPolynomial.coeff p.2 g =
      MvPolynomial.coeff d₁ f * MvPolynomial.coeff d₂ g := by
    apply Finset.sum_eq_single (d₁, d₂)
    · intro p hp_mem hp_ne
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp_mem
      by_contra hnz
      have hp1_f : p.1 ∈ f.support := by
        rw [MvPolynomial.mem_support_iff]; intro h0; simp [h0] at hnz
      have hp2_g : p.2 ∈ g.support := by
        rw [MvPolynomial.mem_support_iff]; intro h0; simp [h0] at hnz
      have hwp : w p.1 + w p.2 = δ := by
        have := congrArg w hp_mem
        rw [map_add, map_add, hd₁_w, hd₂_w, add_zero] at this
        exact this
      have hwp1_ge : δ ≤ w p.1 := hd₀_min p.1 hp1_f
      have hp1_Sf : p.1 ∈ Sf := Finset.mem_filter.mpr ⟨hp1_f, by omega⟩
      have hp2_Sg : p.2 ∈ Sg := Finset.mem_filter.mpr ⟨hp2_g, by omega⟩
      have hφ1 : φ p.1 ≤ φ d₁ := hd₁_max p.1 hp1_Sf
      have hφ2 : φ p.2 ≤ φ d₂ := hd₂_max p.2 hp2_Sg
      have hφ_eq : φ p.1 + φ p.2 = φ d₁ + φ d₂ := by
        rw [← hφ_add, ← hφ_add, hp_mem]
      have hφ1_eq : φ p.1 = φ d₁ := by omega
      have hφ2_eq : φ p.2 = φ d₂ := by omega
      have hp1_eq : p.1 = d₁ := by
        have hfun := base_encoding_inj hM
          (hltM p.1 (Finset.mem_union_left _ hp1_Sf))
          (hltM d₁ (Finset.mem_union_left _ hd₁_Sf)) hφ1_eq
        ext v
        have := congrFun hfun (e v)
        simpa using this
      have hp2_eq : p.2 = d₂ := by
        have hfun := base_encoding_inj hM
          (hltM p.2 (Finset.mem_union_right _ hp2_Sg))
          (hltM d₂ (Finset.mem_union_right _ hd₂_Sg)) hφ2_eq
        ext v
        have := congrFun hfun (e v)
        simpa using this
      exact hp_ne (Prod.ext hp1_eq hp2_eq)
    · intro hnot
      exact (hnot (Finset.HasAntidiagonal.mem_antidiagonal.mpr rfl)).elim
  rw [hsingle]
  exact mul_ne_zero (MvPolynomial.mem_support_iff.mp hd₁_f) (MvPolynomial.mem_support_iff.mp hd₂_g)

/-- Each `P_b = (x_1, …, x_r, y_b)` is a prime ideal. -/
theorem primeIdeal_isPrime (b : Comp T r) : (primeIdeal (K := K) b).IsPrime := by
  rw [primeIdeal_eq_primeMonIdeal]
  refine ⟨?_, ?_⟩
  · intro htop
    have h1 : (1 : MvPolynomial (Var T r) K) ∈ primeMonIdeal (K := K) b := by
      rw [htop]; exact Submodule.mem_top
    have h0 : (0 : Var T r →₀ ℕ) ∈ (1 : MvPolynomial (Var T r) K).support := by
      rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_one]
      simp
    have := h1 0 h0
    simp at this
  · intro f g hfg
    by_contra hnot
    push Not at hnot
    obtain ⟨hf, hg⟩ := hnot
    have hf_ex : ∃ d ∈ f.support, weightB b d = 0 := by
      by_contra hno; push Not at hno
      exact hf (fun d hd => Nat.pos_of_ne_zero (hno d hd))
    have hg_ex : ∃ d ∈ g.support, weightB b d = 0 := by
      by_contra hno; push Not at hno
      exact hg (fun d hd => Nat.pos_of_ne_zero (hno d hd))
    -- Strip terms of `f` with `weightB b ≥ 1`
    let f₂ := ∑ d ∈ f.support.filter (fun d => weightB b d = 0),
      MvPolynomial.monomial d (MvPolynomial.coeff d f)
    have hf₁ : f - f₂ ∈ primeMonIdeal (K := K) b := by
      intro d hd
      rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub] at hd
      by_contra hlt
      have hw0 : weightB b d = 0 := by omega
      have hcf : MvPolynomial.coeff d f₂ = MvPolynomial.coeff d f := by
        simp only [f₂, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
        by_cases hmem : d ∈ f.support
        · rw [Finset.sum_eq_single d]
          · simp
          · intro d' _ hne; simp [hne]
          · intro hno; exact (hno (Finset.mem_filter.mpr ⟨hmem, hw0⟩)).elim
        · rw [MvPolynomial.notMem_support_iff.mp hmem]
          apply Finset.sum_eq_zero
          intro d' hd'
          have hne : d' ≠ d := fun h => hmem (h ▸ (Finset.mem_filter.mp hd').1)
          simp [hne]
      exact hd (sub_eq_zero.mpr hcf.symm)
    have hf₂_ne : f₂ ≠ 0 := by
      obtain ⟨d, hd, hw⟩ := hf_ex
      intro h0
      have hcf := congrArg (MvPolynomial.coeff d) h0
      simp only [f₂, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, MvPolynomial.coeff_zero] at hcf
      rw [Finset.sum_eq_single d] at hcf
      · simp at hcf
        exact MvPolynomial.mem_support_iff.mp hd hcf
      · intro d' _ hne; simp [hne]
      · intro hno; exact (hno (Finset.mem_filter.mpr ⟨hd, hw⟩)).elim
    have hf₂_supp : ∀ d ∈ f₂.support, weightB b d = 0 := by
      intro d hd
      rw [MvPolynomial.mem_support_iff] at hd
      simp only [f₂, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial] at hd
      obtain ⟨d', hd'_mem, hd'_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
      have hdeq : d' = d := by by_contra h; simp [h] at hd'_ne
      subst hdeq
      exact (Finset.mem_filter.mp hd'_mem).2
    have hf₂g : f₂ * g ∈ primeMonIdeal (K := K) b := by
      have : f₂ * g = f * g - (f - f₂) * g := by ring
      rw [this]
      exact Ideal.sub_mem _ hfg (Ideal.mul_mem_right _ _ hf₁)
    obtain ⟨d₁, hd₁, d₂, hd₂, hd₂_w, hmem⟩ := exists_noncancelling_mul_term (weightB b) hf₂_ne hg_ex
    have hw_pos := hf₂g (d₁ + d₂) hmem
    rw [map_add, hf₂_supp d₁ hd₁, hd₂_w] at hw_pos
    omega

/-- The radical of `q_b^m` (for `m ≥ 1`) is `P_b`. -/
theorem compIdeal_pow_radical (b : Comp T r) {m : ℕ} (hm : 1 ≤ m) :
    ((compIdeal (K := K) b) ^ m).radical = primeIdeal (K := K) b := by
  apply le_antisymm
  · have hsub : (compIdeal (K := K) b) ^ m ≤ primeIdeal (K := K) b := by
      rw [compIdeal_pow_eq_monIdeal, primeIdeal_eq_primeMonIdeal]
      intro f hf d hd
      have hin := hf d hd
      unfold inQm at hin
      by_contra hlt
      have hw0 : weightB b d = 0 := by omega
      simp only [weightB, AddMonoidHom.coe_mk, ZeroHom.coe_mk] at hw0
      have hdy : d (Sum.inr b) = 0 := by omega
      have hsum0 : ∑ j : Fin r, d (Sum.inl j) = 0 := by omega
      have hdiv0 : ∑ j : Fin r, d (Sum.inl j) / ((b.val j).val + 1) = 0 := by
        apply Finset.sum_eq_zero
        intro j _
        have hj0 : d (Sum.inl j) = 0 :=
          (Finset.sum_eq_zero_iff.mp hsum0) j (Finset.mem_univ j)
        simp [hj0]
      omega
    intro f ⟨k, hk⟩
    exact (primeIdeal_isPrime b).mem_of_pow_mem k (hsub hk)
  · rw [primeIdeal, Ideal.span_le]
    rintro f (⟨j, rfl⟩ | rfl)
    · refine ⟨m * ((b.val j).val + 1), ?_⟩
      rw [mul_comm, pow_mul]
      exact Ideal.pow_mem_pow (mem_compIdeal_of_xpow (K := K) b j) m
    · exact ⟨m, Ideal.pow_mem_pow (mem_compIdeal_of_y (K := K) b) m⟩

/-- **Lemma 2.2 (Primary):** For every `b ∈ B` and `m ≥ 1`, `q_b^m` is `P_b`-primary. -/
theorem compIdeal_pow_isPrimary (b : Comp T r) {m : ℕ} (hm : 1 ≤ m) :
    ((compIdeal (K := K) b) ^ m).IsPrimary := by
  rw [Ideal.isPrimary_iff]
  refine ⟨?_, ?_⟩
  · intro htop
    have h1 : (1 : MvPolynomial (Var T r) K) ∈ monIdeal (K := K) b m := by
      rw [← compIdeal_pow_eq_monIdeal, htop]; exact Submodule.mem_top
    have h0 : (0 : Var T r →₀ ℕ) ∈ (1 : MvPolynomial (Var T r) K).support := by
      rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_one]; simp
    have := h1 0 h0
    unfold inQm at this; simp at this; omega
  · intro f g hfg
    rw [compIdeal_pow_radical b hm]
    by_cases hg : g ∈ primeIdeal (K := K) b
    · exact Or.inr hg
    · left
      rw [compIdeal_pow_eq_monIdeal] at hfg ⊢
      rw [primeIdeal_eq_primeMonIdeal] at hg
      have hg_ex : ∃ d ∈ g.support, weightB b d = 0 := by
        by_contra hno; push Not at hno
        exact hg (fun d hd => Nat.pos_of_ne_zero (hno d hd))
      classical
      let f₂ := ∑ d ∈ f.support.filter (fun d => ¬ inQm b m d),
        MvPolynomial.monomial d (MvPolynomial.coeff d f)
      have hf₁ : f - f₂ ∈ monIdeal (K := K) b m := by
        intro d hd
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub] at hd
        by_contra hnot
        have hcf : MvPolynomial.coeff d f₂ = MvPolynomial.coeff d f := by
          simp only [f₂, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
          by_cases hmem : d ∈ f.support
          · rw [Finset.sum_eq_single d]
            · simp
            · intro d' _ hne; simp [hne]
            · intro hno; exact (hno (Finset.mem_filter.mpr ⟨hmem, hnot⟩)).elim
          · rw [MvPolynomial.notMem_support_iff.mp hmem]
            apply Finset.sum_eq_zero
            intro d' hd'
            have hne : d' ≠ d := fun h => hmem (h ▸ (Finset.mem_filter.mp hd').1)
            simp [hne]
        exact hd (sub_eq_zero.mpr hcf.symm)
      have hf₂_eq_zero : f₂ = 0 := by
        by_contra hf₂_ne
        have hf₂g : f₂ * g ∈ monIdeal (K := K) b m := by
          have : f₂ * g = f * g - (f - f₂) * g := by ring
          rw [this]
          exact Ideal.sub_mem _ hfg (Ideal.mul_mem_right _ _ hf₁)
        obtain ⟨d₁, hd₁, d₂, hd₂, hd₂_w, hmem⟩ := exists_noncancelling_mul_term (weightB b) hf₂_ne hg_ex
        have hd₁_not : ¬ inQm b m d₁ := by
          rw [MvPolynomial.mem_support_iff] at hd₁
          simp only [f₂, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial] at hd₁
          obtain ⟨d', hd'_mem, hd'_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd₁
          have hdeq : d' = d₁ := by by_contra h; simp [h] at hd'_ne
          subst hdeq
          exact (Finset.mem_filter.mp hd'_mem).2
        have hin := hf₂g (d₁ + d₂) hmem
        simp only [weightB, AddMonoidHom.coe_mk, ZeroHom.coe_mk] at hd₂_w
        have hd₂_y : d₂ (Sum.inr b) = 0 := by omega
        have hd₂_x : ∀ j : Fin r, d₂ (Sum.inl j) = 0 := fun j =>
          (Finset.sum_eq_zero_iff.mp (by omega : ∑ i : Fin r, d₂ (Sum.inl i) = 0)) j (Finset.mem_univ j)
        have hin1 : inQm b m d₁ := by
          unfold inQm at hin ⊢
          have hsum_eq : ∑ j : Fin r, (d₁ + d₂) (Sum.inl j) / ((b.val j).val + 1) =
              ∑ j : Fin r, d₁ (Sum.inl j) / ((b.val j).val + 1) := by
            apply Finset.sum_congr rfl; intro j _; simp [hd₂_x j]
          have hy_eq : (d₁ + d₂) (Sum.inr b) = d₁ (Sum.inr b) := by simp [hd₂_y]
          omega
        exact hd₁_not hin1
      simpa [hf₂_eq_zero] using hf₁

/-- The separating product `U_b = ∏_{b' ≠ b} y_{b'}`. -/
noncomputable def sepProd (b : Comp T r) : MvPolynomial (Var T r) K :=
  ∏ b' ∈ Finset.univ.erase b, yVar (T := T) (r := r) (K := K) b'

private lemma sepProd_not_mem_primeIdeal (b : Comp T r) :
    sepProd (K := K) b ∉ primeIdeal (K := K) b := by
  have hP := primeIdeal_isPrime (K := K) b
  intro hmem
  unfold sepProd at hmem
  have hex : ∃ b' ∈ Finset.univ.erase b, yVar (T := T) (r := r) (K := K) b' ∈ primeIdeal (K := K) b := by
    suffices h : ∀ S : Finset (Comp T r), (∏ b' ∈ S, yVar (T := T) (r := r) (K := K) b') ∈ primeIdeal (K := K) b →
        ∃ b' ∈ S, yVar (T := T) (r := r) (K := K) b' ∈ primeIdeal (K := K) b from h _ hmem
    intro S hS
    induction S using Finset.induction_on with
    | empty =>
      simp only [Finset.prod_empty] at hS
      exact (hP.ne_top (Ideal.eq_top_of_isUnit_mem _ hS isUnit_one)).elim
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha] at hS
      rcases hP.mem_or_mem hS with h1 | h2
      · exact ⟨a, Finset.mem_insert_self a s, h1⟩
      · obtain ⟨b', hb', hbm⟩ := ih h2
        exact ⟨b', Finset.mem_insert_of_mem hb', hbm⟩
  obtain ⟨b', hb'_mem, hb'_in⟩ := hex
  have hne : b' ≠ b := (Finset.mem_erase.mp hb'_mem).1
  rw [primeIdeal_eq_primeMonIdeal] at hb'_in
  have hsupp : Finsupp.single (Sum.inr b' : Var T r) 1 ∈ (yVar (T := T) (r := r) (K := K) b').support := by
    simp [yVar, MvPolynomial.X]
  have hw := hb'_in _ hsupp
  simp only [weightB, AddMonoidHom.coe_mk, ZeroHom.coe_mk] at hw
  have hsum0 : ∑ j : Fin r, (Finsupp.single (Sum.inr b' : Var T r) 1) (Sum.inl j) = 0 := by
    apply Finset.sum_eq_zero; intro j _; exact Finsupp.single_eq_of_ne (by simp)
  have hy0 : (Finsupp.single (Sum.inr b' : Var T r) 1) (Sum.inr b) = 0 :=
    Finsupp.single_eq_of_ne (fun h => hne (Sum.inr.inj h).symm)
  omega

private lemma sepProd_mem_compIdeal_of_ne {b b' : Comp T r} (hne : b' ≠ b) :
    sepProd (K := K) b ∈ compIdeal (K := K) b' := by
  unfold sepProd
  have hmem : b' ∈ Finset.univ.erase b := Finset.mem_erase.mpr ⟨hne, Finset.mem_univ b'⟩
  rw [← Finset.mul_prod_erase _ _ hmem]
  exact Ideal.mul_mem_right _ _ (mem_compIdeal_of_y (K := K) b')

/-- **Irredundancy:** For every `b ∈ B`, `U_b ∈ ⨅ b' ≠ b, q_{b'}` and `U_b ∉ q_b`. -/
theorem irredundant_decomposition (b : Comp T r) :
    sepProd (K := K) b ∈ (⨅ (b' : Comp T r) (_ : b' ≠ b), compIdeal (K := K) b') ∧
    sepProd (K := K) b ∉ compIdeal (K := K) b := by
  constructor
  · rw [Ideal.mem_iInf]
    intro b'
    rw [Ideal.mem_iInf]
    intro hne
    exact sepProd_mem_compIdeal_of_ne hne
  · intro hmem
    have hsub : compIdeal (K := K) b ≤ primeIdeal (K := K) b := by
      have := compIdeal_pow_radical (K := K) b (m := 1) le_rfl
      rw [pow_one] at this
      rw [← this]
      exact Ideal.le_radical
    exact sepProd_not_mem_primeIdeal b (hsub hmem)

/-- Pairwise incomparability of the primes `P_b`. -/
theorem primeIdeal_incomparable {b₁ b₂ : Comp T r} (h : primeIdeal (K := K) b₁ ≤ primeIdeal (K := K) b₂) :
    b₁ = b₂ := by
  by_contra hne
  have hy : yVar (T := T) (r := r) (K := K) b₁ ∈ primeIdeal (K := K) b₂ :=
    h (Ideal.subset_span (Or.inr rfl))
  rw [primeIdeal_eq_primeMonIdeal] at hy
  have hsupp : Finsupp.single (Sum.inr b₁ : Var T r) 1 ∈ (yVar (T := T) (r := r) (K := K) b₁).support := by
    simp [yVar, MvPolynomial.X]
  have hw := hy _ hsupp
  simp only [weightB, AddMonoidHom.coe_mk, ZeroHom.coe_mk] at hw
  have hsum0 : ∑ j : Fin r, (Finsupp.single (Sum.inr b₁ : Var T r) 1) (Sum.inl j) = 0 := by
    apply Finset.sum_eq_zero; intro j _; exact Finsupp.single_eq_of_ne (by simp)
  have hy0 : (Finsupp.single (Sum.inr b₁ : Var T r) 1) (Sum.inr b₂) = 0 :=
    Finsupp.single_eq_of_ne (fun h => hne (Sum.inr.inj h).symm)
  omega

/-- Exact minimal primes: `minimalPrimes (counterIdeal T r K) = { P_b | b ∈ B }`. -/
theorem minimalPrimes_eq :
    (counterIdeal T r K).minimalPrimes = Set.range (primeIdeal (T := T) (r := r) (K := K)) := by
  have hprime_prod : ∀ {Q : Ideal (MvPolynomial (Var T r) K)}, Q.IsPrime →
      ∀ (S : Finset (Comp T r)) (g : Comp T r → MvPolynomial (Var T r) K),
        (∏ b ∈ S, g b) ∈ Q → ∃ b ∈ S, g b ∈ Q := by
    intro Q hQ S g hprod
    induction S using Finset.induction_on with
    | empty =>
      simp only [Finset.prod_empty] at hprod
      exact (hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hprod isUnit_one)).elim
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha] at hprod
      rcases hQ.mem_or_mem hprod with h1 | h2
      · exact ⟨a, Finset.mem_insert_self a s, h1⟩
      · obtain ⟨b', hb', hbm⟩ := ih h2
        exact ⟨b', Finset.mem_insert_of_mem hb', hbm⟩
  ext Q
  constructor
  · rintro ⟨⟨hQ_prime, hIQ⟩, hQ_min⟩
    have hex_b : ∃ b : Comp T r, primeIdeal (K := K) b ≤ Q := by
      by_contra hno
      push Not at hno
      have hnot_q : ∀ b : Comp T r, ¬ compIdeal (K := K) b ≤ Q := by
        intro b hle
        have hrad := Ideal.radical_mono hle
        rw [show (compIdeal (K := K) b).radical = primeIdeal (K := K) b by
          simpa [pow_one] using compIdeal_pow_radical (K := K) b (m := 1) le_rfl,
          hQ_prime.radical] at hrad
        exact hno b hrad
      choose g hg_in hg_out using fun b => SetLike.not_le_iff_exists.mp (hnot_q b)
      have hprod_Q : ∏ b : Comp T r, g b ∈ Q := by
        apply hIQ
        rw [counterIdeal, Ideal.mem_iInf]
        intro b
        rw [← Finset.mul_prod_erase Finset.univ g (Finset.mem_univ b)]
        exact Ideal.mul_mem_right _ _ (hg_in b)
      obtain ⟨b, _, hbQ⟩ := hprime_prod hQ_prime Finset.univ g hprod_Q
      exact hg_out b hbQ
    obtain ⟨b, hbQ⟩ := hex_b
    have hI_le_Pb : counterIdeal T r K ≤ primeIdeal (K := K) b := by
      have h1 : counterIdeal T r K ≤ compIdeal (K := K) b := iInf_le _ b
      have h2 : compIdeal (K := K) b ≤ primeIdeal (K := K) b := by
        have := compIdeal_pow_radical (K := K) b (m := 1) le_rfl
        rw [pow_one] at this; rw [← this]; exact Ideal.le_radical
      exact le_trans h1 h2
    have hQ_le_Pb : Q ≤ primeIdeal (K := K) b := hQ_min ⟨primeIdeal_isPrime b, hI_le_Pb⟩ hbQ
    exact ⟨b, (le_antisymm hbQ hQ_le_Pb)⟩
  · rintro ⟨b, rfl⟩
    refine ⟨⟨primeIdeal_isPrime b, ?_⟩, ?_⟩
    · have h1 : counterIdeal T r K ≤ compIdeal (K := K) b := iInf_le _ b
      have h2 : compIdeal (K := K) b ≤ primeIdeal (K := K) b := by
        have := compIdeal_pow_radical (K := K) b (m := 1) le_rfl
        rw [pow_one] at this; rw [← this]; exact Ideal.le_radical
      exact le_trans h1 h2
    · intro Q ⟨hQ_prime, hIQ⟩ hQ_le
      have hex_b' : ∃ b' : Comp T r, primeIdeal (K := K) b' ≤ Q := by
        by_contra hno
        push Not at hno
        have hnot_q : ∀ b' : Comp T r, ¬ compIdeal (K := K) b' ≤ Q := by
          intro b' hle
          have hrad := Ideal.radical_mono hle
          rw [show (compIdeal (K := K) b').radical = primeIdeal (K := K) b' by
            simpa [pow_one] using compIdeal_pow_radical (K := K) b' (m := 1) le_rfl,
            hQ_prime.radical] at hrad
          exact hno b' hrad
        choose g hg_in hg_out using fun b' => SetLike.not_le_iff_exists.mp (hnot_q b')
        have hprod_Q : ∏ b' : Comp T r, g b' ∈ Q := by
          apply hIQ
          rw [counterIdeal, Ideal.mem_iInf]
          intro b'
          rw [← Finset.mul_prod_erase Finset.univ g (Finset.mem_univ b')]
          exact Ideal.mul_mem_right _ _ (hg_in b')
        obtain ⟨b', _, hb'Q⟩ := hprime_prod hQ_prime Finset.univ g hprod_Q
        exact hg_out b' hb'Q
      obtain ⟨b', hb'Q⟩ := hex_b'
      have heq : b' = b := primeIdeal_incomparable (le_trans hb'Q hQ_le)
      subst heq
      exact hb'Q

/-- Every `P_b` is generated by exactly `r + 1` distinct variables (`{x_1, …, x_r, y_b}`). -/
theorem primeIdeal_varSet_card (b : Comp T r) :
    ((Finset.univ.image (Sum.inl : Fin r → Var T r)) ∪ {Sum.inr b}).card = r + 1 := by
  have hnot : (Sum.inr b : Var T r) ∉ Finset.univ.image Sum.inl := by
    simp
  rw [Finset.union_singleton, Finset.card_insert_of_notMem hnot,
    Finset.card_image_of_injective _ Sum.inl_injective, Finset.card_univ, Fintype.card_fin]

instance primeIdeal_isPrime_inst (b : Comp T r) : (primeIdeal (K := K) b).IsPrime :=
  primeIdeal_isPrime b

/-- Symbolic power `I^(m) = ⨅ b : Comp T r, (I^m R_{P_b} ∩ R)` via exact localization at each `P_b`. -/
noncomputable def symbolicPower (T r : ℕ) (K : Type*) [Field K] (m : ℕ) :
    Ideal (MvPolynomial (Var T r) K) :=
  ⨅ b : Comp T r,
    Ideal.comap (algebraMap (MvPolynomial (Var T r) K) (Localization.AtPrime (primeIdeal (K := K) b)))
      (Ideal.map (algebraMap (MvPolynomial (Var T r) K) (Localization.AtPrime (primeIdeal (K := K) b)))
        ((counterIdeal T r K) ^ m))

/-- **Lemma 2.2 (Localization):** For every `b ∈ B` and `m ≥ 1`,
`I^m R_{P_b} ∩ R = q_b^m`. -/
theorem localization_component_eq (b : Comp T r) {m : ℕ} (hm : 1 ≤ m) :
    Ideal.comap (algebraMap (MvPolynomial (Var T r) K) (Localization.AtPrime (primeIdeal (K := K) b)))
      (Ideal.map (algebraMap (MvPolynomial (Var T r) K) (Localization.AtPrime (primeIdeal (K := K) b)))
        ((counterIdeal T r K) ^ m)) =
      (compIdeal (K := K) b) ^ m := by
  ext f
  rw [Ideal.mem_comap, IsLocalization.mem_map_algebraMap_iff (primeIdeal (K := K) b).primeCompl]
  constructor
  · rintro ⟨⟨⟨g, hg⟩, u⟩, heq⟩
    have heq' : algebraMap (MvPolynomial (Var T r) K) (Localization.AtPrime (primeIdeal (K := K) b))
        (f * (u : MvPolynomial (Var T r) K)) =
        algebraMap (MvPolynomial (Var T r) K) (Localization.AtPrime (primeIdeal (K := K) b)) g := by
      simpa [map_mul, Algebra.smul_def, mul_comm] using heq
    obtain ⟨s, hs⟩ := (IsLocalization.eq_iff_exists (primeIdeal (K := K) b).primeCompl _).mp heq'
    have hpow_le : ∀ k : ℕ, (counterIdeal T r K) ^ k ≤ (compIdeal (K := K) b) ^ k := by
      intro k
      have hle : counterIdeal T r K ≤ compIdeal (K := K) b := iInf_le _ b
      induction k with
      | zero => exact le_rfl
      | succ k ih =>
        rw [pow_succ, pow_succ]
        exact Ideal.mul_mono ih hle
    have hprod_mem : ((s : MvPolynomial (Var T r) K) * (u : MvPolynomial (Var T r) K)) * f ∈
        (compIdeal (K := K) b) ^ m := by
      have hmul_eq : ((s : MvPolynomial (Var T r) K) * (u : MvPolynomial (Var T r) K)) * f =
          (s : MvPolynomial (Var T r) K) * g := by
        simpa [mul_assoc, mul_comm, mul_left_comm] using hs
      rw [hmul_eq]
      exact Ideal.mul_mem_left _ _ (hpow_le m hg)
    have hprim := compIdeal_pow_isPrimary (K := K) b hm
    rw [Ideal.isPrimary_iff] at hprim
    rcases hprim.2 (by rwa [mul_comm]) with hf_in | hsu_rad
    · exact hf_in
    · rw [compIdeal_pow_radical b hm] at hsu_rad
      exact (((primeIdeal (K := K) b).primeCompl.mul_mem s.2 u.2) hsu_rad).elim
  · intro hf
    have hUb_mul : ∀ g ∈ compIdeal (K := K) b, sepProd (K := K) b * g ∈ counterIdeal T r K := by
      intro g hg
      rw [counterIdeal, Ideal.mem_iInf]
      intro b'
      by_cases hbb' : b' = b
      · subst hbb'; exact Ideal.mul_mem_left _ _ hg
      · exact Ideal.mul_mem_right _ _ (sepProd_mem_compIdeal_of_ne hbb')
    have hpow_mul : ∀ k : ℕ, ∀ g ∈ (compIdeal (K := K) b) ^ k,
        (sepProd (K := K) b) ^ k * g ∈ (counterIdeal T r K) ^ k := by
      intro k
      induction k with
      | zero => intro g _; rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      | succ k ih =>
        intro g hg
        rw [pow_succ] at hg ⊢
        refine Submodule.mul_induction_on hg ?_ ?_
        · intro a ha c hc
          have h1 : (sepProd (K := K) b) ^ k * a ∈ (counterIdeal T r K) ^ k := ih a ha
          have h2 : sepProd (K := K) b * c ∈ counterIdeal T r K := hUb_mul c hc
          have heq : (sepProd (K := K) b) ^ (k + 1) * (a * c) =
              ((sepProd (K := K) b) ^ k * a) * (sepProd (K := K) b * c) := by
            rw [pow_succ]; ring
          rw [heq]
          exact Ideal.mul_mem_mul h1 h2
        · intro a c ha hc
          rw [mul_add]
          exact Ideal.add_mem _ ha hc
    have hU_not : (sepProd (K := K) b) ^ m ∈ (primeIdeal (K := K) b).primeCompl :=
      Submonoid.pow_mem _ (sepProd_not_mem_primeIdeal b) m
    refine ⟨⟨⟨(sepProd (K := K) b) ^ m * f, hpow_mul m f hf⟩, ⟨(sepProd (K := K) b) ^ m, hU_not⟩⟩, ?_⟩
    simp [mul_comm]

/-- **Lemma 2.2 (Symbolic powers):** For every `m ≥ 1`, `I^(m) = ⨅ b, q_b^m`. -/
theorem symbolicPower_eq_iInf {m : ℕ} (hm : 1 ≤ m) :
    symbolicPower T r K m = ⨅ b : Comp T r, (compIdeal (K := K) b) ^ m := by
  unfold symbolicPower
  exact iInf_congr fun b => localization_component_eq (K := K) b hm

/-- Monomial membership in `I^(m)` for `m ≥ 1`. -/
lemma mem_symbolicPower_iff {m : ℕ} (hm : 1 ≤ m) (f : MvPolynomial (Var T r) K) :
    f ∈ symbolicPower T r K m ↔ ∀ b : Comp T r, ∀ d ∈ f.support, inQm b m d := by
  rw [symbolicPower_eq_iInf hm, Ideal.mem_iInf]
  constructor
  · intro h b d hd
    have hb := h b
    rw [compIdeal_pow_eq_monIdeal] at hb
    exact hb d hd
  · intro h b
    rw [compIdeal_pow_eq_monIdeal]
    exact h b

/-! ### Section 3: Initial degree `α(I) = T` (Lemma 2.3) -/

private lemma monDeg_le_totalDegree {σ : Type*} {f : MvPolynomial σ K} {d : σ →₀ ℕ}
    (hd : d ∈ f.support) : monDeg d ≤ f.totalDegree := by
  unfold monDeg MvPolynomial.totalDegree
  exact Finset.le_sup (f := fun s : σ →₀ ℕ => s.sum (fun _ k => k)) hd

private lemma monDeg_eq_sum_x_add_sum_y (d : Var T r →₀ ℕ) :
    monDeg d = (∑ j : Fin r, d (Sum.inl j)) + (∑ b : Comp T r, d (Sum.inr b)) := by
  unfold monDeg
  rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fintype.sum_sum_type]

/-- **Lemma 2.3 (Upper):** `x_0^T ∈ I`, nonzero, of `totalDegree = T`. -/
lemma x0_pow_T_mem_counterIdeal (_hT : 1 ≤ T) (hr : 1 ≤ r) :
    (xVar (T := T) (r := r) (K := K) ⟨0, hr⟩) ^ T ∈ counterIdeal T r K ∧
    (xVar (T := T) (r := r) (K := K) ⟨0, hr⟩) ^ T ≠ 0 ∧
    ((xVar (T := T) (r := r) (K := K) ⟨0, hr⟩) ^ T).totalDegree = T := by
  refine ⟨?_, ?_, ?_⟩
  · rw [counterIdeal, Ideal.mem_iInf]
    intro b
    have h1 : compIdeal (K := K) b = monIdeal (K := K) b 1 := by
      simpa [pow_one] using compIdeal_pow_eq_monIdeal (K := K) b 1
    rw [h1]
    intro d hd
    have hpow : (xVar (T := T) (r := r) (K := K) ⟨0, hr⟩) ^ T =
        MvPolynomial.monomial (Finsupp.single (Sum.inl ⟨0, hr⟩) T) (1 : K) := by
      simp [xVar, MvPolynomial.X_pow_eq_monomial]
    rw [hpow] at hd
    have hdeq : d = Finsupp.single (Sum.inl ⟨0, hr⟩) T :=
      Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hd)
    subst hdeq
    unfold inQm
    have hb0 : (b.val ⟨0, hr⟩).val + 1 ≤ T := by
      have := (b.val ⟨0, hr⟩).isLt; omega
    have hdiv : 1 ≤ T / ((b.val ⟨0, hr⟩).val + 1) :=
      (Nat.le_div_iff_mul_le (Nat.succ_pos _)).mpr (by omega)
    have hle : T / ((b.val ⟨0, hr⟩).val + 1) ≤
        ∑ j : Fin r, (Finsupp.single (Sum.inl ⟨0, hr⟩ : Var T r) T) (Sum.inl j) / ((b.val j).val + 1) := by
      have := Finset.single_le_sum (f := fun j : Fin r =>
          (Finsupp.single (Sum.inl ⟨0, hr⟩ : Var T r) T) (Sum.inl j) / ((b.val j).val + 1))
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ ⟨0, hr⟩)
      simpa using this
    omega
  · exact pow_ne_zero T (MvPolynomial.X_ne_zero _)
  · simp [xVar, MvPolynomial.totalDegree_X_pow]

/-- **Lemma 2.3 (Lower):** Every monomial in `I` has degree `≥ T` (whenever `1 ≤ T ≤ r`). -/
lemma monDeg_ge_T_of_mem_counterIdeal (hT : 1 ≤ T) (hTr : T ≤ r) {d : Var T r →₀ ℕ}
    (hd : ∀ b : Comp T r, inQm b 1 d) :
    T ≤ monDeg d := by
  rw [monDeg_eq_sum_x_add_sum_y]
  set s := ∑ j : Fin r, d (Sum.inl j)
  by_cases hs : T ≤ s
  · omega
  · -- `s ≤ T - 1`
    by_cases hseq : s = T - 1
    · -- Unique `b ∈ B` with `b_j = d(inl j)` has `d(inr b) ≥ 1`
      have hltT : ∀ j : Fin r, d (Sum.inl j) < T := by
        intro j
        have hle : d (Sum.inl j) ≤ s :=
          Finset.single_le_sum (f := fun i : Fin r => d (Sum.inl i)) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
        omega
      let b₀ : Comp T r := ⟨fun j => ⟨d (Sum.inl j), hltT j⟩, hseq⟩
      have hin := hd b₀
      unfold inQm at hin
      have hsum0 : ∑ j : Fin r, d (Sum.inl j) / ((b₀.val j).val + 1) = 0 := by
        apply Finset.sum_eq_zero; intro j _
        exact Nat.div_eq_of_lt (by simp [b₀])
      have hdy : 1 ≤ d (Sum.inr b₀) := by omega
      have hle_y : d (Sum.inr b₀) ≤ ∑ b : Comp T r, d (Sum.inr b) :=
        Finset.single_le_sum (f := fun b : Comp T r => d (Sum.inr b)) (fun _ _ => Nat.zero_le _) (Finset.mem_univ b₀)
      omega
    · -- `s ≤ T - 2`: adding `T - 1 - s` to coordinate `k` produces `r` distinct vectors `b_k ∈ B`
      have hrem_pos : 1 ≤ T - 1 - s := by omega
      have hltT : ∀ (k j : Fin r), (if j = k then d (Sum.inl j) + (T - 1 - s) else d (Sum.inl j)) < T := by
        intro k j
        have hle : d (Sum.inl j) ≤ s :=
          Finset.single_le_sum (f := fun i : Fin r => d (Sum.inl i)) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
        split_ifs <;> omega
      let mkB : Fin r → Comp T r := fun k =>
        ⟨fun j => ⟨if j = k then d (Sum.inl j) + (T - 1 - s) else d (Sum.inl j), hltT k j⟩, by
          have hsplit : ∑ j : Fin r, (if j = k then d (Sum.inl j) + (T - 1 - s) else d (Sum.inl j)) =
              (∑ j : Fin r, d (Sum.inl j)) + (T - 1 - s) := by
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ k),
              ← Finset.add_sum_erase _ _ (Finset.mem_univ k)]
            have hrest : ∑ j ∈ Finset.univ.erase k,
                (if j = k then d (Sum.inl j) + (T - 1 - s) else d (Sum.inl j)) =
                ∑ j ∈ Finset.univ.erase k, d (Sum.inl j) := by
              apply Finset.sum_congr rfl; intro j hj
              simp [(Finset.mem_erase.mp hj).1]
            rw [hrest]; simp; omega
          change (∑ j : Fin r, (if j = k then d (Sum.inl j) + (T - 1 - s) else d (Sum.inl j))) = T - 1
          rw [hsplit]; omega⟩
      have hmkB_inj : Function.Injective mkB := by
        intro k₁ k₂ heq
        by_contra hne
        have hval := congrArg (fun b : Comp T r => (b.val k₁).val) heq
        simp [mkB, hne] at hval
        omega
      have hge_one : ∀ k : Fin r, 1 ≤ d (Sum.inr (mkB k)) := by
        intro k
        have hin := hd (mkB k)
        unfold inQm at hin
        have hsum0 : ∑ j : Fin r, d (Sum.inl j) / (((mkB k).val j).val + 1) = 0 := by
          apply Finset.sum_eq_zero; intro j _
          apply Nat.div_eq_of_lt
          dsimp [mkB]; split_ifs <;> omega
        omega
      have hsum_y : r ≤ ∑ b : Comp T r, d (Sum.inr b) := by
        calc r = (Finset.univ.image mkB).card := by
              rw [Finset.card_image_of_injective _ hmkB_inj, Finset.card_univ, Fintype.card_fin]
          _ = ∑ _b ∈ Finset.univ.image mkB, 1 := by simp
          _ ≤ ∑ b ∈ Finset.univ.image mkB, d (Sum.inr b) := by
              apply Finset.sum_le_sum; intro b hb
              rcases Finset.mem_image.mp hb with ⟨k, _, rfl⟩
              exact hge_one k
          _ ≤ ∑ b : Comp T r, d (Sum.inr b) :=
              Finset.sum_le_univ_sum_of_nonneg (fun _ => Nat.zero_le _)
      omega

/-- **Lemma 2.3:** `α(I) = T`. -/
theorem initialDeg_counterIdeal_eq (hT : 1 ≤ T) (hTr : T ≤ r) :
    initialDeg (counterIdeal T r K) = T := by
  have hr : 1 ≤ r := by omega
  obtain ⟨hmem, hne, hdeg⟩ := x0_pow_T_mem_counterIdeal (T := T) (r := r) (K := K) hT hr
  have hS_ne : { d : ℕ | ∃ f ∈ counterIdeal T r K, f ≠ 0 ∧ f.totalDegree = d }.Nonempty :=
    ⟨T, _, hmem, hne, hdeg⟩
  apply le_antisymm
  · exact Nat.sInf_le ⟨_, hmem, hne, hdeg⟩
  · apply le_csInf hS_ne
    rintro d ⟨f, hf_in, hf_ne, rfl⟩
    obtain ⟨m, hm⟩ := MvPolynomial.support_nonempty.mpr hf_ne
    have hforall : ∀ b : Comp T r, inQm b 1 m := by
      intro b
      have hb : f ∈ compIdeal (K := K) b := (Ideal.mem_iInf.mp hf_in) b
      have h1 : compIdeal (K := K) b = monIdeal (K := K) b 1 := by
        simpa [pow_one] using compIdeal_pow_eq_monIdeal (K := K) b 1
      rw [h1] at hb
      exact hb m hm
    exact le_trans (monDeg_ge_T_of_mem_counterIdeal hT hTr hforall) (monDeg_le_totalDegree hm)

/-! ### Section 4: Exact Waldschmidt constant `α̂(I) = 2r / (2r - T + 1)` (Lemma 2.4) -/

/-- Test monomial `u_k = ∏_j x_j^(2k)` of degree `2rk`. -/
noncomputable def testMonomial (T r k : ℕ) (K : Type*) [Field K] : MvPolynomial (Var T r) K :=
  MvPolynomial.monomial (∑ j : Fin r, Finsupp.single (Sum.inl j : Var T r) (2 * k)) (1 : K)

/-- **Lemma 2.4 (Upper bound):** `u_k ∈ I^((2r - T + 1)k)` is nonzero of degree `2rk`. -/
theorem testMonomial_mem_symbolicPower (hT : 4 ≤ T) (hTr : T ≤ r) {k : ℕ} (hk : 1 ≤ k) :
    testMonomial T r k K ∈ symbolicPower T r K ((2 * r - T + 1) * k) ∧
    testMonomial T r k K ≠ 0 ∧
    (testMonomial T r k K).totalDegree = 2 * r * k := by
  let d₀ : Var T r →₀ ℕ := ∑ j : Fin r, Finsupp.single (Sum.inl j : Var T r) (2 * k)
  have hd₀_inl : ∀ j : Fin r, d₀ (Sum.inl j) = 2 * k := by
    intro j
    simp only [d₀, Finsupp.finsetSum_apply]
    rw [Finset.sum_eq_single j]
    · simp
    · intro j' _ hne
      exact Finsupp.single_eq_of_ne (fun h => hne (Sum.inl.inj h).symm)
    · intro hno; exact (hno (Finset.mem_univ j)).elim
  have hd₀_inr : ∀ b : Comp T r, d₀ (Sum.inr b) = 0 := by
    intro b
    simp only [d₀, Finsupp.finsetSum_apply]
    apply Finset.sum_eq_zero; intro j _
    exact Finsupp.single_eq_of_ne (by simp)
  have hm_pos : 1 ≤ (2 * r - T + 1) * k := by
    have : 1 ≤ 2 * r - T + 1 := by omega
    exact Nat.mul_pos this hk
  refine ⟨?_, ?_, ?_⟩
  · rw [mem_symbolicPower_iff hm_pos]
    intro b d hd
    have hdeq : d = d₀ := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset hd)
    subst hdeq
    unfold inQm
    have hterm : ∀ j : Fin r,
        (if (b.val j).val = 0 then 2 * k else if (b.val j).val = 1 then k else 0) ≤
          d₀ (Sum.inl j) / ((b.val j).val + 1) := by
      intro j
      rw [hd₀_inl j]
      split_ifs with h0 h1
      · simp [h0]
      · simp [h1]
      · exact Nat.zero_le _
    have hpart : ∀ j : Fin r,
        (if (b.val j).val = 0 then 2 else if (b.val j).val = 1 then 1 else 0) + (b.val j).val ≥ 2 := by
      intro j; split_ifs <;> omega
    have hsum_ge : 2 * r ≤ (∑ j : Fin r,
        (if (b.val j).val = 0 then 2 else if (b.val j).val = 1 then 1 else 0)) +
        ∑ j : Fin r, (b.val j).val := by
      rw [← Finset.sum_add_distrib]
      calc 2 * r = ∑ _j : Fin r, 2 := by simp [mul_comm]
        _ ≤ _ := Finset.sum_le_sum (fun j _ => hpart j)
    have hsum_b : ∑ j : Fin r, (b.val j).val = T - 1 := b.property
    have hsum_k : (∑ j : Fin r,
        (if (b.val j).val = 0 then 2 * k else if (b.val j).val = 1 then k else 0)) =
        (∑ j : Fin r, (if (b.val j).val = 0 then 2 else if (b.val j).val = 1 then 1 else 0)) * k := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl; intro j _
      split_ifs <;> ring
    have hle1 : (2 * r - T + 1) * k ≤
        (∑ j : Fin r, (if (b.val j).val = 0 then 2 else if (b.val j).val = 1 then 1 else 0)) * k :=
      Nat.mul_le_mul_right k (by omega)
    have hle2 : (∑ j : Fin r,
        (if (b.val j).val = 0 then 2 * k else if (b.val j).val = 1 then k else 0)) ≤
        ∑ j : Fin r, d₀ (Sum.inl j) / ((b.val j).val + 1) :=
      Finset.sum_le_sum (fun j _ => hterm j)
    omega
  · simp [testMonomial]
  · unfold testMonomial
    rw [MvPolynomial.totalDegree_monomial _ (one_ne_zero)]
    have : d₀.sum (fun _ n => n) = monDeg d₀ := rfl
    rw [this, monDeg_eq_sum_x_add_sum_y]
    simp [hd₀_inl, hd₀_inr]
    ring

/-- **Lemma 2.4 (Lower bound):** Every monomial `d` in `I^(m)` (`m ≥ 1`) satisfies
`2 * r * m ≤ (2 * r - T + 1) * monDeg d`. -/
theorem monDeg_symbolicPower_lower (hT : 4 ≤ T) (hTr : T ≤ r) {m : ℕ} (_hm : 1 ≤ m)
    {d : Var T r →₀ ℕ} (hd : ∀ b : Comp T r, inQm b m d) :
    2 * r * m ≤ (2 * r - T + 1) * monDeg d := by
  -- Sum the binary-vector inequalities `2 * ∑_j c_j / (b_j + 1) + 2 * d_b ≥ 2 * m` over all
  -- binary subsets `S ∈ powersetCard (T - 1) univ` (in bijection with `O ⊆ Comp T r`)!
  let O_fin : Finset (Finset (Fin r)) := Finset.powersetCard (T - 1) (Finset.univ : Finset (Fin r))
  have hmk : ∀ S ∈ O_fin, ∑ j : Fin r, (if j ∈ S then (1 : ℕ) else 0) = T - 1 := by
    intro S hS
    rw [Finset.sum_boole, Nat.cast_id]
    have hcard := (Finset.mem_powersetCard.mp hS).2
    have hfilt : Finset.univ.filter (fun j : Fin r => j ∈ S) = S := by
      ext j; simp
    rw [hfilt, hcard]
  let toComp : ∀ S ∈ O_fin, Comp T r := fun S hS =>
    ⟨fun j => ⟨if j ∈ S then 1 else 0, by split_ifs <;> omega⟩, hmk S hS⟩
  have htoComp_inj : ∀ S₁ (h1 : S₁ ∈ O_fin) S₂ (h2 : S₂ ∈ O_fin),
      toComp S₁ h1 = toComp S₂ h2 → S₁ = S₂ := by
    intro S₁ h1 S₂ h2 heq
    ext j
    have hv := congrArg (fun b : Comp T r => (b.val j).val) heq
    dsimp [toComp] at hv
    split_ifs at hv <;> simp_all
  -- For each `S ∈ O_fin`, `2 * m ≤ (∑ j, (if j ∈ S then 1 else 2) * d (inl j)) + 2 * d (inr (toComp S))`!
  have hpt : ∀ S (hS : S ∈ O_fin),
      2 * m ≤ (∑ j : Fin r, (if j ∈ S then 1 else 2) * d (Sum.inl j)) +
        2 * d (Sum.inr (toComp S hS)) := by
    intro S hS
    have hin := hd (toComp S hS)
    unfold inQm at hin
    have h2 : ∀ j : Fin r,
        2 * (d (Sum.inl j) / (((toComp S hS).val j).val + 1)) ≤
          (if j ∈ S then 1 else 2) * d (Sum.inl j) := by
      intro j
      dsimp [toComp]
      split_ifs <;> omega
    have hsum : 2 * ∑ j : Fin r, d (Sum.inl j) / (((toComp S hS).val j).val + 1) ≤
        ∑ j : Fin r, (if j ∈ S then 1 else 2) * d (Sum.inl j) := by
      rw [Finset.mul_sum]
      exact Finset.sum_le_sum (fun j _ => h2 j)
    omega
  -- Sum over `S ∈ O_fin`:
  have hsum_all : ∑ _S ∈ O_fin, (2 * m) ≤
      (∑ S ∈ O_fin, ∑ j : Fin r, (if j ∈ S then 1 else 2) * d (Sum.inl j)) +
      (∑ S ∈ O_fin.attach, 2 * d (Sum.inr (toComp S.1 S.2))) := by
    rw [← Finset.sum_attach O_fin (fun _ => 2 * m),
      ← Finset.sum_attach O_fin (fun S => ∑ j : Fin r, (if j ∈ S then 1 else 2) * d (Sum.inl j)),
      ← Finset.sum_add_distrib]
    exact Finset.sum_le_sum (fun S _ => hpt S.1 S.2)
  -- LHS = `2 * m * Nat.choose r (T - 1)`
  have hLHS : ∑ _S ∈ O_fin, (2 * m) = Nat.choose r (T - 1) * (2 * m) := by
    rw [Finset.sum_const, Finset.card_powersetCard, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
  -- Column weight for each `j : Fin r`: `∑_{S ∈ O_fin} (if j ∈ S then 1 else 2) = 2 * C(r, T-1) - C(r-1, T-2)`
  -- Even cleaner identity: `r * (∑_{S ∈ O_fin} (if j ∈ S then 1 else 2)) = (2 * r - T + 1) * C(r, T - 1)`!
  have hcol : ∀ j : Fin r,
      r * (∑ S ∈ O_fin, (if j ∈ S then (1 : ℕ) else 2)) =
        (2 * r - T + 1) * Nat.choose r (T - 1) := by
    intro j
    -- Count `{S ∈ O_fin | j ∈ S}` = `Nat.choose (r - 1) (T - 2)`!
    have hcount_in : (O_fin.filter (fun S => j ∈ S)).card = Nat.choose (r - 1) (T - 2) := by
      have hbij : (O_fin.filter (fun S => j ∈ S)).card =
          (Finset.powersetCard (T - 2) (Finset.univ.erase j)).card := by
        apply Finset.card_nbij (fun S => S.erase j)
        · intro S hS
          simp only [Finset.mem_coe, Finset.mem_filter, O_fin, Finset.mem_powersetCard] at hS ⊢
          refine ⟨Finset.erase_subset_erase j hS.1.1, ?_⟩
          rw [Finset.card_erase_of_mem hS.2, hS.1.2]; omega
        · intro S₁ h1 S₂ h2 heq
          simp only [Finset.mem_coe, Finset.mem_filter] at h1 h2
          dsimp only at heq
          rw [← Finset.insert_erase h1.2, ← Finset.insert_erase h2.2, heq]
        · intro U hU
          simp only [Finset.mem_coe, Finset.mem_powersetCard] at hU
          have hj_not : j ∉ U := fun h => (Finset.mem_erase.mp (hU.1 h)).1 rfl
          refine ⟨insert j U, ?_, ?_⟩
          · simp only [Finset.mem_coe, Finset.mem_filter, O_fin, Finset.mem_powersetCard]
            refine ⟨⟨Finset.subset_univ _, ?_⟩, Finset.mem_insert_self j U⟩
            rw [Finset.card_insert_of_notMem hj_not, hU.2]; omega
          · dsimp only; exact Finset.erase_insert hj_not
      rw [hbij, Finset.card_powersetCard, Finset.card_erase_of_mem (Finset.mem_univ j),
        Finset.card_univ, Fintype.card_fin]
    have hsum_j : (∑ S ∈ O_fin, (if j ∈ S then (1 : ℕ) else 2)) +
        (O_fin.filter (fun S => j ∈ S)).card = 2 * O_fin.card := by
      have h1 : ∀ S ∈ O_fin, (if j ∈ S then (1 : ℕ) else 2) + (if j ∈ S then 1 else 0) = 2 := by
        intro S _; split_ifs <;> rfl
      have h2 := Finset.sum_congr rfl h1
      rw [Finset.sum_add_distrib, Finset.sum_const, smul_eq_mul, Finset.sum_boole, Nat.cast_id] at h2
      omega
    have hO_card : O_fin.card = Nat.choose r (T - 1) := by
      rw [Finset.card_powersetCard, Finset.card_univ, Fintype.card_fin]
    have hbin : r * Nat.choose (r - 1) (T - 2) = (T - 1) * Nat.choose r (T - 1) := by
      -- Double-count `{(i, S) : Fin r × O_fin | i ∈ S}`:
      have hcount_all : ∀ i : Fin r, (O_fin.filter (fun S => i ∈ S)).card = Nat.choose (r - 1) (T - 2) := by
        intro i
        have hbij : (O_fin.filter (fun S => i ∈ S)).card =
            (Finset.powersetCard (T - 2) (Finset.univ.erase i)).card := by
          apply Finset.card_nbij (fun S => S.erase i)
          · intro S hS
            simp only [Finset.mem_coe, Finset.mem_filter, O_fin, Finset.mem_powersetCard] at hS ⊢
            refine ⟨Finset.erase_subset_erase i hS.1.1, ?_⟩
            rw [Finset.card_erase_of_mem hS.2, hS.1.2]; omega
          · intro S₁ h1 S₂ h2 heq
            simp only [Finset.mem_coe, Finset.mem_filter] at h1 h2
            dsimp only at heq
            rw [← Finset.insert_erase h1.2, ← Finset.insert_erase h2.2, heq]
          · intro U hU
            simp only [Finset.mem_coe, Finset.mem_powersetCard] at hU
            have hi_not : i ∉ U := fun h => (Finset.mem_erase.mp (hU.1 h)).1 rfl
            refine ⟨insert i U, ?_, ?_⟩
            · simp only [Finset.mem_coe, Finset.mem_filter, O_fin, Finset.mem_powersetCard]
              refine ⟨⟨Finset.subset_univ _, ?_⟩, Finset.mem_insert_self i U⟩
              rw [Finset.card_insert_of_notMem hi_not, hU.2]; omega
            · dsimp only; exact Finset.erase_insert hi_not
        rw [hbij, Finset.card_powersetCard, Finset.card_erase_of_mem (Finset.mem_univ i),
          Finset.card_univ, Fintype.card_fin]
      have hL : ∑ i : Fin r, ∑ S ∈ O_fin, (if i ∈ S then (1 : ℕ) else 0) =
          r * Nat.choose (r - 1) (T - 2) := by
        have ht : ∀ i : Fin r, ∑ S ∈ O_fin, (if i ∈ S then (1 : ℕ) else 0) = Nat.choose (r - 1) (T - 2) := by
          intro i; rw [Finset.sum_boole, Nat.cast_id, hcount_all i]
        rw [Finset.sum_congr rfl (fun i _ => ht i), Finset.sum_const, Finset.card_univ,
          Fintype.card_fin, smul_eq_mul]
      have hR : ∑ S ∈ O_fin, ∑ i : Fin r, (if i ∈ S then (1 : ℕ) else 0) =
          (T - 1) * Nat.choose r (T - 1) := by
        have ht : ∀ S ∈ O_fin, ∑ i : Fin r, (if i ∈ S then (1 : ℕ) else 0) = T - 1 := hmk
        rw [Finset.sum_congr rfl ht, Finset.sum_const, smul_eq_mul, hO_card, mul_comm]
      rw [← hL, Finset.sum_comm, hR]
    rw [hO_card, hcount_in] at hsum_j
    have hmul : r * (∑ S ∈ O_fin, (if j ∈ S then (1 : ℕ) else 2)) + r * Nat.choose (r - 1) (T - 2) =
        r * (2 * Nat.choose r (T - 1)) := by
      rw [← mul_add, hsum_j]
    rw [hbin] at hmul
    zify [show T ≤ 2 * r by omega, show 1 ≤ T by omega] at hmul ⊢
    linarith
  -- Swap sum for the `x`-part: `r * (∑_S ∑_j w(S,j) c_j) = (2r - T + 1) * C(r, T-1) * ∑_j c_j`
  have hx_part : r * (∑ S ∈ O_fin, ∑ j : Fin r, (if j ∈ S then 1 else 2) * d (Sum.inl j)) =
      (2 * r - T + 1) * Nat.choose r (T - 1) * (∑ j : Fin r, d (Sum.inl j)) := by
    rw [Finset.sum_comm, Finset.mul_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [← Finset.sum_mul, ← mul_assoc, hcol j]
  -- Bound the `y`-part: `∑_{S ∈ O_fin.attach} d (inr (toComp S)) ≤ ∑_{b : Comp T r} d (inr b)`
  have hy_sub : ∑ S ∈ O_fin.attach, d (Sum.inr (toComp S.1 S.2)) ≤
      ∑ b : Comp T r, d (Sum.inr b) := by
    let img : Finset (Comp T r) := O_fin.attach.image (fun S => toComp S.1 S.2)
    have hinj : Function.Injective (fun S : { S // S ∈ O_fin } => toComp S.1 S.2) := by
      intro S₁ S₂ h
      exact Subtype.ext (htoComp_inj S₁.1 S₁.2 S₂.1 S₂.2 h)
    calc ∑ S ∈ O_fin.attach, d (Sum.inr (toComp S.1 S.2))
        = ∑ b ∈ img, d (Sum.inr b) := by
            rw [Finset.sum_image (fun _ _ _ _ h => hinj h)]
      _ ≤ ∑ b : Comp T r, d (Sum.inr b) :=
            Finset.sum_le_univ_sum_of_nonneg (fun _ => Nat.zero_le _)
  -- Also `2 * r ≤ (2 * r - T + 1) * Nat.choose r (T - 1)` because `Nat.choose r (T - 1) ≥ 2`!
  have hchoose_ge : 2 * r ≤ (2 * r - T + 1) * Nat.choose r (T - 1) := by
    have hc_ge : 2 ≤ Nat.choose r (T - 1) := by
      have h1' : Nat.choose (r - 1) (T - 2) ≥ 1 := Nat.choose_pos (by omega)
      have h2' : Nat.choose (r - 1) (T - 1) ≥ 1 := Nat.choose_pos (by omega)
      have hpas : Nat.choose r (T - 1) = Nat.choose (r - 1) (T - 2) + Nat.choose (r - 1) (T - 1) := by
        have hr1 : r = (r - 1).succ := by omega
        have hT1 : T - 1 = (T - 2).succ := by omega
        conv_lhs => rw [hr1, hT1]
        rw [Nat.choose_succ_succ, ← hT1]
      omega
    have hcoeff : r ≤ 2 * r - T + 1 := by omega
    nlinarith
  have hy_part : r * (∑ S ∈ O_fin.attach, 2 * d (Sum.inr (toComp S.1 S.2))) ≤
      (2 * r - T + 1) * Nat.choose r (T - 1) * (∑ b : Comp T r, d (Sum.inr b)) := by
    rw [← Finset.mul_sum, ← mul_assoc, mul_comm r 2]
    exact Nat.mul_le_mul hchoose_ge hy_sub
  -- Combine `r * hLHS ≤ hx_part + hy_part` and cancel `Nat.choose r (T - 1) > 0`!
  have hcomb : Nat.choose r (T - 1) * (2 * r * m) ≤
      Nat.choose r (T - 1) * ((2 * r - T + 1) * monDeg d) := by
    rw [monDeg_eq_sum_x_add_sum_y, mul_add]
    have hmul_all := Nat.mul_le_mul_left r hsum_all
    rw [hLHS, mul_add, hx_part] at hmul_all
    have h1 : r * (Nat.choose r (T - 1) * (2 * m)) = Nat.choose r (T - 1) * (2 * r * m) := by ring
    have h2 : (2 * r - T + 1) * Nat.choose r (T - 1) * (∑ j : Fin r, d (Sum.inl j)) +
        (2 * r - T + 1) * Nat.choose r (T - 1) * (∑ b : Comp T r, d (Sum.inr b)) =
        Nat.choose r (T - 1) * ((2 * r - T + 1) * (∑ j : Fin r, d (Sum.inl j)) +
          (2 * r - T + 1) * (∑ b : Comp T r, d (Sum.inr b))) := by ring
    omega
  have hc_pos : 0 < Nat.choose r (T - 1) := Nat.choose_pos (by omega)
  exact Nat.le_of_mul_le_mul_left hcomb hc_pos

/-- **Lemma 2.4 (Initial degree lower bound):** `2 * r * m ≤ (2 * r - T + 1) * α(I^(m))` for all `m ≥ 1`. -/
theorem initialDeg_symbolicPower_lower (hT : 4 ≤ T) (hTr : T ≤ r) {m : ℕ} (hm : 1 ≤ m) :
    2 * r * m ≤ (2 * r - T + 1) * initialDeg (symbolicPower T r K m) := by
  have hS_ne : { d : ℕ | ∃ f ∈ symbolicPower T r K m, f ≠ 0 ∧ f.totalDegree = d }.Nonempty := by
    obtain ⟨hmem, hne, _⟩ := testMonomial_mem_symbolicPower (T := T) (r := r) (K := K) hT hTr hm
    have hmem_m : testMonomial T r m K ∈ symbolicPower T r K m := by
      have hm_mul : 1 ≤ (2 * r - T + 1) * m := Nat.mul_pos (by omega) hm
      rw [mem_symbolicPower_iff hm]
      rw [mem_symbolicPower_iff hm_mul] at hmem
      intro b d hd
      have hin := hmem b d hd
      unfold inQm at hin ⊢
      have hle : m ≤ (2 * r - T + 1) * m := Nat.le_mul_of_pos_left m (by omega)
      omega
    exact ⟨_, _, hmem_m, hne, rfl⟩
  have hmem_sInf := Nat.sInf_mem hS_ne
  obtain ⟨f, hf_in, hf_ne, hdeg⟩ := hmem_sInf
  obtain ⟨d, hd⟩ := MvPolynomial.support_nonempty.mpr hf_ne
  have hforall : ∀ b : Comp T r, inQm b m d := fun b => (mem_symbolicPower_iff hm f).mp hf_in b d hd
  have hlow := monDeg_symbolicPower_lower hT hTr hm hforall
  have hle_deg : monDeg d ≤ initialDeg (symbolicPower T r K m) := by
    rw [initialDeg, ← hdeg]
    exact monDeg_le_totalDegree hd
  exact le_trans hlow (Nat.mul_le_mul_left _ hle_deg)

/-- **Lemma 2.4 (Initial degree upper bound):** `α(I^((2r - T + 1)k)) ≤ 2rk` for all `k ≥ 1`. -/
theorem initialDeg_symbolicPower_upper (hT : 4 ≤ T) (hTr : T ≤ r) {k : ℕ} (hk : 1 ≤ k) :
    initialDeg (symbolicPower T r K ((2 * r - T + 1) * k)) ≤ 2 * r * k := by
  obtain ⟨hmem, hne, hdeg⟩ := testMonomial_mem_symbolicPower (T := T) (r := r) (K := K) hT hTr hk
  exact Nat.sInf_le ⟨_, hmem, hne, hdeg⟩

/-- Monotonicity of symbolic powers: `m₁ ≤ m₂ → I^(m₂) ≤ I^(m₁)` (for `1 ≤ m₁`). -/
lemma symbolicPower_anti {m₁ m₂ : ℕ} (hm₁ : 1 ≤ m₁) (hle : m₁ ≤ m₂) :
    symbolicPower T r K m₂ ≤ symbolicPower T r K m₁ := by
  intro f hf
  rw [mem_symbolicPower_iff hm₁]
  rw [mem_symbolicPower_iff (le_trans hm₁ hle)] at hf
  intro b d hd
  have := hf b d hd
  unfold inQm at this ⊢
  omega

/-- Exact Waldschmidt limit: `α(I^(m)) / m → 2r / (2r - T + 1)` as `m → ∞`. -/
theorem waldschmidt_tendsto (hT : 4 ≤ T) (hTr : T ≤ r) :
    Filter.Tendsto
      (fun m : ℕ => (initialDeg (symbolicPower T r K m) : ℝ) / (m : ℝ))
      Filter.atTop
      (nhds ((2 * (r : ℝ)) / ((2 * r - T + 1 : ℕ) : ℝ))) := by
  set D : ℕ := 2 * r - T + 1
  have hD_pos : 0 < D := by omega
  have hDR : (0 : ℝ) < (D : ℝ) := Nat.cast_pos.mpr hD_pos
  have hL_lower : ∀ m : ℕ, 1 ≤ m →
      (2 * (r : ℝ)) / (D : ℝ) ≤ (initialDeg (symbolicPower T r K m) : ℝ) / (m : ℝ) := by
    intro m hm
    have hmR : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
    rw [div_le_div_iff₀ hDR hmR]
    have hnat := initialDeg_symbolicPower_lower (T := T) (r := r) (K := K) hT hTr hm
    have hcast : ((2 * r * m : ℕ) : ℝ) ≤ ((D * initialDeg (symbolicPower T r K m) : ℕ) : ℝ) :=
      Nat.cast_le.mpr hnat
    push_cast at hcast
    linarith
  have hL_upper : ∀ m : ℕ, 1 ≤ m →
      (initialDeg (symbolicPower T r K m) : ℝ) / (m : ℝ) ≤
        (2 * (r : ℝ)) / (D : ℝ) + (2 * (r : ℝ)) / (m : ℝ) := by
    intro m hm
    have hmR : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
    set k : ℕ := m / D + 1
    have hk_pos : 1 ≤ k := Nat.succ_le_succ (Nat.zero_le _)
    have hmk : m ≤ D * k := by
      have hlt := Nat.lt_div_mul_add hD_pos (a := m)
      have h1 : D * k = (m / D) * D + D := by dsimp only [k]; ring
      omega
    have hdeg_le : initialDeg (symbolicPower T r K m) ≤ 2 * r * k := by
      obtain ⟨hmem, hne, hdeg⟩ := testMonomial_mem_symbolicPower (T := T) (r := r) (K := K) hT hTr hk_pos
      have hmem_m : testMonomial T r k K ∈ symbolicPower T r K m :=
        symbolicPower_anti hm hmk hmem
      exact Nat.sInf_le ⟨_, hmem_m, hne, hdeg⟩
    have hk_bound : (k : ℝ) ≤ (m : ℝ) / (D : ℝ) + 1 := by
      have hdiv : ((m / D : ℕ) : ℝ) * (D : ℝ) ≤ (m : ℝ) := by
        exact_mod_cast Nat.div_mul_le_self m D
      have hdiv' : ((m / D : ℕ) : ℝ) ≤ (m : ℝ) / (D : ℝ) := (le_div_iff₀ hDR).mpr hdiv
      have hk_cast : (k : ℝ) = ((m / D : ℕ) : ℝ) + 1 := by simp [k]
      linarith
    have h1 : (initialDeg (symbolicPower T r K m) : ℝ) ≤ 2 * (r : ℝ) * ((m : ℝ) / (D : ℝ) + 1) := by
      have hc : (initialDeg (symbolicPower T r K m) : ℝ) ≤ ((2 * r * k : ℕ) : ℝ) :=
        Nat.cast_le.mpr hdeg_le
      push_cast at hc
      have hr0 : (0 : ℝ) ≤ 2 * (r : ℝ) := by positivity
      nlinarith
    rw [div_le_iff₀ hmR]
    have h2 : ((2 * (r : ℝ)) / (D : ℝ) + (2 * (r : ℝ)) / (m : ℝ)) * (m : ℝ) =
        2 * (r : ℝ) * ((m : ℝ) / (D : ℝ) + 1) := by
      field_simp [ne_of_gt hmR, ne_of_gt hDR]
    linarith
  -- Squeeze between constant `2r / D` and `2r / D + 2r / m`!
  have htop : Filter.Tendsto (fun m : ℕ => (2 * (r : ℝ)) / (D : ℝ) + (2 * (r : ℝ)) / (m : ℝ))
      Filter.atTop (nhds ((2 * (r : ℝ)) / (D : ℝ) + 0)) := by
    apply Filter.Tendsto.add tendsto_const_nhds
    exact tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop
  rw [add_zero] at htop
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds htop
    (Filter.eventually_atTop.mpr ⟨1, hL_lower⟩)
    (Filter.eventually_atTop.mpr ⟨1, hL_upper⟩)

/-! ### Section 5: Strict Counterexample to Basak–Bijender–Kumar Question 4.14 -/

/-- **Main Theorem (Infinite Counterexample Family):**
For every `T ≥ 4` and `r ≥ 1` with `T * (T - 1) < r * (T - 3)`, the ideal
`I = counterIdeal T r K` has `α(I) = T`, big-height `e = r + 1`, and exact
Waldschmidt constant `α̂(I) = 2r / (2r - T + 1)` strictly violating
`α̂(I) ≥ (α(I) + e - 1) / (e + 1)`. -/
theorem waldschmidt_strict_counterexample (hT : 4 ≤ T) (hcond : T * (T - 1) < r * (T - 3)) :
    let e : ℕ := r + 1
    initialDeg (counterIdeal T r K) = T ∧
    Filter.Tendsto
      (fun m : ℕ => (initialDeg (symbolicPower T r K m) : ℝ) / (m : ℝ))
      Filter.atTop
      (nhds ((2 * (r : ℝ)) / ((2 * r - T + 1 : ℕ) : ℝ))) ∧
    (2 * (r : ℝ)) / ((2 * r - T + 1 : ℕ) : ℝ) <
      ((initialDeg (counterIdeal T r K) : ℝ) + (e : ℝ) - 1) / ((e : ℝ) + 1) := by
  have hTr : T ≤ r := by
    by_contra hlt
    have hr_le : r ≤ T - 1 := by omega
    have h1 : r * (T - 3) ≤ (T - 1) * (T - 3) := Nat.mul_le_mul_right (T - 3) hr_le
    have h2 : (T - 1) * (T - 3) ≤ T * (T - 1) := by
      rw [mul_comm (T - 1) (T - 3)]
      exact Nat.mul_le_mul_right (T - 1) (by omega)
    omega
  have hα : initialDeg (counterIdeal T r K) = T := initialDeg_counterIdeal_eq (by omega) hTr
  refine ⟨hα, waldschmidt_tendsto hT hTr, ?_⟩
  rw [hα]
  have hD_pos : (0 : ℝ) < ((2 * r - T + 1 : ℕ) : ℝ) := by
    exact_mod_cast (show 0 < 2 * r - T + 1 by omega)
  have he_pos : (0 : ℝ) < (((r + 1 : ℕ) : ℝ) + 1) := by positivity
  rw [div_lt_div_iff₀ hD_pos he_pos]
  have hsub : ((2 * r - T + 1 : ℕ) : ℝ) = 2 * (r : ℝ) - (T : ℝ) + 1 := by
    rw [Nat.cast_add, Nat.cast_sub (by omega : T ≤ 2 * r)]; push_cast; ring
  rw [hsub]
  have hcondR : ((T * (T - 1) : ℕ) : ℝ) < ((r * (T - 3) : ℕ) : ℝ) := Nat.cast_lt.mpr hcond
  have hT1 : ((T - 1 : ℕ) : ℝ) = (T : ℝ) - 1 := by rw [Nat.cast_sub (by omega)]; norm_num
  have hT3 : ((T - 3 : ℕ) : ℝ) = (T : ℝ) - 3 := by rw [Nat.cast_sub (by omega)]; norm_num
  push_cast at hcondR ⊢
  rw [hT1, hT3] at hcondR
  nlinarith

/-- **Headline Counterexample `(T, r) = (4, 13)`:**
455 minimal primary components of height `e = 14`, `α(I) = 4`, and
`α̂(I) = 26 / 23 < 17 / 15 = (α(I) + e - 1) / (e + 1)`. -/
theorem headline_counterexample_4_13 :
    initialDeg (counterIdeal 4 13 K) = 4 ∧
    Filter.Tendsto
      (fun m : ℕ => (initialDeg (symbolicPower 4 13 K m) : ℝ) / (m : ℝ))
      Filter.atTop
      (nhds ((26 : ℝ) / 23)) ∧
    ((26 : ℝ) / 23) < ((4 : ℝ) + 14 - 1) / (14 + 1) := by
  have h := waldschmidt_strict_counterexample (T := 4) (r := 13) (K := K) (by omega) (by omega)
  rcases h with ⟨h1, h2, h3⟩
  refine ⟨h1, ?_, ?_⟩
  · convert h2 using 2; norm_num
  · norm_num

end BasakWaldschmidtMonomial
