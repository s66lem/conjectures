theorem hasStar (c : Triple (cycleGraph 14) → Fin 9) (hc : IsProperColoring (cycleGraph 14) 9 c) :
    ∃ i x, ∀ s, c s = i → x ∈ s.val := by
  apply has_star (samples := samples) (width := 10) (by decide) _ _ _ _ _ tested c hc
  · have h : samples.all (fun e => decide (StableTriple (cycleGraph 14) e.1)) := by decide +kernel
    exact fun e he => of_decide_eq_true (List.all_eq_true.mp h e he)
  · have h : samples.all (fun e => decide (e.2 < 2^10)) := by decide +kernel
    exact fun e he => of_decide_eq_true (List.all_eq_true.mp h e he)
  · decide +kernel
