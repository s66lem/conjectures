theorem hasStar (c : Triple (cycleGraph 16) → Fin 11) (hc : IsProperColoring (cycleGraph 16) 11 c) :
    ∃ i x, ∀ s, c s = i → x ∈ s.val := by
  apply has_star (samples := samples) (width := 9) (by decide) _ _ _ _ _ tested c hc
  · have h : samples.all (fun e => decide (StableTriple (cycleGraph 16) e.1)) := by decide +kernel
    exact fun e he => of_decide_eq_true (List.all_eq_true.mp h e he)
  · have h : samples.all (fun e => decide (e.2 < 2^9)) := by decide +kernel
    exact fun e he => of_decide_eq_true (List.all_eq_true.mp h e he)
  · decide +kernel
  · decide +kernel
