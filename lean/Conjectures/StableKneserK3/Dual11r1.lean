theorem hasStar (c : Triple (componentGraph 12 11 1 false) → Fin 7) (hc : IsProperColoring (componentGraph 12 11 1 false) 7 c) :
    ∃ i x, ∀ s, c s = i → x ∈ s.val := by
  apply forces_star valid (by decide) node0 (by decide +kernel)
    (fun i => ⟨triples i, stable i⟩) (triple_surjective _ ?_) (Fin.ofNat 12) ?_ ?_ c hc
  · change ∀ a b e : Fin 12, a ≠ b → a ≠ e → b ≠ e → ¬(componentGraph 12 11 1 false).Adj a b → ¬(componentGraph 12 11 1 false).Adj a e →
      ¬(componentGraph 12 11 1 false).Adj b e → ∃ i, triples i = {a,b,e}
    decide +kernel
  · have h : ∀ x : Fin 12, ∀ j : Fin 121, (starTable.get x).testBit j.val → x ∈ triples j := by
